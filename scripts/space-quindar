#!/usr/bin/env python3
"""
====================================================================
 🔊 APOLLO QUINDAR AUDIO ENGINE & SOUND EFFECTS DISPATCHER
====================================================================
 Plays authentic Apollo mission audio tones (2525Hz / 2475Hz)
 for space events, ISS tracking alerts, and desktop feedback.
====================================================================
"""

import sys
import os
import json
import subprocess
import shutil

CONFIG_FILE = os.path.expanduser("~/.config/spaceera/audio-config.json")
SOUND_DIR = os.path.expanduser("~/.config/spaceera/sounds")

SOUND_MAP = {
    "intro": "quindar-intro.wav",
    "outro": "quindar-outro.wav",
    "beep": "quindar-beep.wav",
    "acquired": "iss-acquired.wav",
    "alert": "iss-acquired.wav",
}

def load_config():
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {"enabled": True, "volume": 1.0}

def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

def play_sound(sound_name):
    cfg = load_config()
    if not cfg.get("enabled", True):
        return

    wav_file = SOUND_MAP.get(sound_name, sound_name)
    wav_path = os.path.join(SOUND_DIR, wav_file)
    if not os.path.isfile(wav_path):
        return

    player = shutil.which("pw-play") or shutil.which("paplay")
    if not player:
        return

    try:
        subprocess.Popen([player, wav_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    if len(sys.argv) < 2:
        play_sound("beep")
        return

    cmd = sys.argv[1].lower()
    if cmd == "toggle":
        cfg = load_config()
        cfg["enabled"] = not cfg.get("enabled", True)
        save_config(cfg)
        status = "ENABLED" if cfg["enabled"] else "MUTED"
        print(f"Quindar Audio: {status}")
        if cfg["enabled"]:
            play_sound("beep")
    elif cmd == "status":
        cfg = load_config()
        print("ENABLED" if cfg.get("enabled", True) else "MUTED")
    elif cmd in SOUND_MAP:
        play_sound(cmd)
    else:
        play_sound("beep")

if __name__ == "__main__":
    main()
