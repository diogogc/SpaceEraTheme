"""
====================================================================
 🧭 SPACE MISSION CONTROL: HYPRLAND KEYBINDINGS GUIDE & LAUNCHER
====================================================================
 Interactive searchable flight control cheatsheet.
 Features:
   - Ranked priority list (most relevant controls at the top)
   - Real-time search filter with keyboard navigation
   - Press [ENTER] to execute any selected tool directly
   - [ESC] or [Q] instant close
   - Space Mission Control zero-white-background theme sync
====================================================================
"""

import sys
import os
import json
import subprocess
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk

