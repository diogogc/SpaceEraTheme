    def update_telemetry_ui(self):
        d = self.telemetry
        if not d.get("ok"):
            self.lbl_coords.set_text("OFFLINE")
            self.lbl_alt_vel.set_text("Waiting for orbital feed...")
            return

        lat = float(d.get("latitude", 0))
        lon = float(d.get("longitude", 0))
        alt = float(d.get("altitude", 0))
        vel = float(d.get("velocity", 0))
        vis = str(d.get("visibility", "unknown")).upper()
        mach = vel / 1234.8

        lat_d = "N" if lat >= 0 else "S"
        lon_d = "E" if lon >= 0 else "W"
        self.lbl_coords.set_text(f"{abs(lat):.2f}°{lat_d}  {abs(lon):.2f}°{lon_d}")
        self.lbl_alt_vel.set_text(f"ALT: {alt:.1f} km // VEL: {vel:,.0f} km/h (M{mach:.1f}) // {vis}")

        loc = d.get("user_location", {})
        if loc.get("configured"):
            self.lbl_base_loc.set_text(loc.get("city", "HOME BASE"))
        else:
            self.lbl_base_loc.set_text("BASE: NOT CONFIGURED")

        np = d.get("next_pass", {})
        if np.get("available"):
            cd = np.get("countdown", 0)
            hrs = cd // 3600
            mins = (cd % 3600) // 60
            dur = np.get("duration", 0)
            self.lbl_pass_time.set_text(f"NEXT PASS: in {hrs}h {mins:02d}m (Dur: {dur//60}m {dur%60:02d}s)")
            fl = np.get("flare", {})
            self.lbl_pass_flare.set_text(f"OPTICAL: {fl.get('label', 'Radio Only')}")

            if np.get("current"):
                self.lbl_pass_status.set_text("STATUS: [ ⚡ ISS ACQUIRED IN FOOTPRINT ]")
                self.lbl_pass_status.get_style_context().remove_class("status-nominal")
                self.lbl_pass_status.get_style_context().add_class("status-acquired")
            else:
                self.lbl_pass_status.set_text("STATUS: [ TRACKING NOMINAL ]")
                self.lbl_pass_status.get_style_context().remove_class("status-acquired")
                self.lbl_pass_status.get_style_context().add_class("status-nominal")
        else:
            self.lbl_pass_time.set_text("NEXT PASS: NO PASS IN 24H")
            self.lbl_pass_flare.set_text("OPTICAL: STANDBY")
            self.lbl_pass_status.set_text("STATUS: [ OUT OF FOOTPRINT RANGE ]")
            self.lbl_pass_status.get_style_context().remove_class("status-acquired")
            self.lbl_pass_status.get_style_context().add_class("status-nominal")

    def on_draw_map(self, widget, cr):
        t = self.theme
        avail_w = widget.get_allocated_width()
        avail_h = widget.get_allocated_height()

        # Canvas Outer Background
        cr.set_source_rgb(0.02, 0.03, 0.05)
        cr.paint()

        # Strict 2:1 Equirectangular Aspect Ratio (360° Lon : 180° Lat)
        target_aspect = 2.0
        pad = 6.0
        canvas_w = max(10.0, avail_w - 2 * pad)
        canvas_h = max(10.0, avail_h - 2 * pad)

        if canvas_w / canvas_h > target_aspect:
            map_h = canvas_h
            map_w = map_h * target_aspect
        else:
            map_w = canvas_w
            map_h = map_w / target_aspect

        map_x0 = pad + (canvas_w - map_w) / 2.0
        map_y0 = pad + (canvas_h - map_h) / 2.0

        def map_coords(lon, lat):
            x = map_x0 + ((lon + 180.0) / 360.0) * map_w
            y = map_y0 + ((90.0 - lat) / 180.0) * map_h
            return x, y

        # 1. Map Frame & Ocean Background
        cr.save()
        cr.rectangle(map_x0, map_y0, map_w, map_h)
        cr.set_source_rgb(0.04, 0.06, 0.09)
        cr.fill_preserve()
        cr.set_source_rgba(0.2, 0.3, 0.45, 0.8)
        cr.set_line_width(1.0)
        cr.stroke()
        cr.restore()

        # Clip all rendering strictly inside the 2:1 map rectangle
        cr.save()
        cr.rectangle(map_x0, map_y0, map_w, map_h)
        cr.clip()

        # 2. Draw Lat/Lon Grid Lines
        cr.set_source_rgba(t['map_grid'][0], t['map_grid'][1], t['map_grid'][2], 0.7)
        cr.set_line_width(0.7)
        for lat_g in [-60, -30, 0, 30, 60]:
            _, y = map_coords(0, lat_g)
            cr.move_to(map_x0, y)
            cr.line_to(map_x0 + map_w, y)
            cr.stroke()
        for lon_g in [-120, -60, 0, 60, 120]:
            x, _ = map_coords(lon_g, 0)
            cr.move_to(x, map_y0)
            cr.line_to(x, map_y0 + map_h)
            cr.stroke()

        # Equator & Prime Meridian Emphasis
        cr.set_source_rgba(t['map_coast'][0], t['map_coast'][1], t['map_coast'][2], 0.4)
        _, eq_y = map_coords(0, 0)
        cr.move_to(map_x0, eq_y)
        cr.line_to(map_x0 + map_w, eq_y)
        cr.stroke()

        # 3. Draw Coastlines
        cr.set_source_rgb(t['map_coast'][0], t['map_coast'][1], t['map_coast'][2])
        cr.set_line_width(0.85)
        for poly in self.coastlines:
            if not poly or len(poly) < 2:
                continue
            fx, fy = map_coords(poly[0][0], poly[0][1])
            cr.move_to(fx, fy)
            prev_pt = poly[0]
            for pt in poly[1:]:
                px, py = map_coords(pt[0], pt[1])
                # Prevent wrap lines across antimeridian
                if abs(pt[0] - prev_pt[0]) < 180:
                    cr.line_to(px, py)
                else:
                    cr.move_to(px, py)
                prev_pt = pt
            cr.stroke()

        d = self.telemetry
        if d.get("ok"):
            # 4. Draw 19-Point Orbit Ground Track Projection
            orbit = d.get("orbit", [])
            if len(orbit) >= 2:
                cr.set_source_rgba(t['orbit_color'][0], t['orbit_color'][1], t['orbit_color'][2], 0.8)
                cr.set_dash([4.0, 3.0])
                cr.set_line_width(1.3)
                for i in range(len(orbit) - 1):
                    p1 = orbit[i]
                    p2 = orbit[i + 1]
                    x1, y1 = map_coords(p1["longitude"], p1["latitude"])
                    x2, y2 = map_coords(p2["longitude"], p2["latitude"])
                    # Avoid antimeridian wrap jump
                    if abs(p2["longitude"] - p1["longitude"]) < 180:
                        cr.move_to(x1, y1)
                        cr.line_to(x2, y2)
                        cr.stroke()
                cr.set_dash([])

            # 5. Draw Home Base Location
            loc = d.get("user_location", {})
            if loc.get("configured"):
                hx, hy = map_coords(loc["longitude"], loc["latitude"])
                cr.set_source_rgb(t['home_color'][0], t['home_color'][1], t['home_color'][2])
                cr.arc(hx, hy, 3.5, 0, 2 * math.pi)
                cr.fill()
                cr.arc(hx, hy, 7.5, 0, 2 * math.pi)
                cr.set_line_width(1.0)
                cr.stroke()

                # Target Pin Crosshairs
                cr.move_to(hx - 9, hy)
                cr.line_to(hx + 9, hy)
                cr.move_to(hx, hy - 9)
                cr.line_to(hx, hy + 9)
                cr.stroke()

            # 6. Draw ISS Visibility Footprint
            iss_lat = float(d.get("latitude", 0))
            iss_lon = float(d.get("longitude", 0))
            ix, iy = map_coords(iss_lon, iss_lat)

            footprint_rad_px = (2200.0 / 40075.0) * map_w
            cr.set_source_rgba(t['footprint_color'][0], t['footprint_color'][1], t['footprint_color'][2], 0.12)
            cr.arc(ix, iy, footprint_rad_px, 0, 2 * math.pi)
            cr.fill()

            cr.set_source_rgba(t['footprint_color'][0], t['footprint_color'][1], t['footprint_color'][2], 0.6)
            cr.set_line_width(1.0)
            cr.arc(ix, iy, footprint_rad_px, 0, 2 * math.pi)
            cr.stroke()

            # 7. Draw ISS Satellite Marker & Pulsing Beacon
            pulse_r = 5.5 + 3.5 * math.sin(self.pulse_phase)
            cr.set_source_rgba(t['iss_color'][0], t['iss_color'][1], t['iss_color'][2], 0.35)
            cr.arc(ix, iy, pulse_r, 0, 2 * math.pi)
            cr.fill()

            # Core ISS Icon
            cr.set_source_rgb(t['iss_color'][0], t['iss_color'][1], t['iss_color'][2])
            cr.rectangle(ix - 3, iy - 3, 6, 6)
            cr.fill()

            # Solar Panels
            cr.set_line_width(1.2)
            cr.move_to(ix - 7, iy)
            cr.line_to(ix + 7, iy)
            cr.move_to(ix, iy - 7)
            cr.line_to(ix, iy + 7)
            cr.stroke()

        cr.restore()

    def on_set_city(self, widget):
        city = self.entry_city.get_text().strip()
        if city:
            self.lbl_footer.set_text(f"GEOCODING: '{city}'...")
            subprocess.run([TRACKER_BIN, "--set-city", city], check=False)
            subprocess.run(["space-quindar", "outro"], check=False)
            self.entry_city.set_text("")
            self.fetch_telemetry()

    def on_clear_city(self, widget):
        subprocess.run([TRACKER_BIN, "--clear-city"], check=False)
        subprocess.run(["space-quindar", "beep"], check=False)
        self.fetch_telemetry()

    def on_refresh_tle(self, widget):
        self.lbl_footer.set_text("UPDATING TLE FROM CELESTRAK...")
        subprocess.run([TRACKER_BIN, "--fetch-tle"], check=False)
        subprocess.run(["space-quindar", "beep"], check=False)
        self.fetch_telemetry()

    def on_key_press(self, widget, event):
        if event.keyval in [Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Q]:
            self.close_window()
            return True
        return False

    def close_window(self):
        Gtk.main_quit()

def main():
    win = IssConsoleWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
