    def build_ui(self):
        self.set_name("main-window")
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # Header Panel
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class("header-panel")

        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        title = Gtk.Label(label="🛰️ ISS ORBITAL TELEMETRY // MISSION CONTROL CONSOLE")
        title.set_xalign(0.0)
        title.get_style_context().add_class("header-title")
        title_box.pack_start(title, True, True, 0)

        btn_close = Gtk.Button(label="[ ESC ]")
        btn_close.get_style_context().add_class("close-btn")
        btn_close.connect("clicked", lambda b: self.close_window())
        title_box.pack_end(btn_close, False, False, 0)

        header.pack_start(title_box, False, False, 0)

        sub = Gtk.Label(label="APOLLO GUIDANCE TELEMETRY & WORLD PROJECTION // NORAD CAT ID: 25544")
        sub.set_xalign(0.0)
        sub.get_style_context().add_class("header-sub")
        header.pack_start(sub, False, False, 0)

        main_box.pack_start(header, False, False, 0)

        # Central Split Body: Map Area (Left) + Telemetry Instrumentation (Right)
        body_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        body_box.set_margin_start(12)
        body_box.set_margin_end(12)
        body_box.set_margin_top(8)
        body_box.set_margin_bottom(8)
        main_box.pack_start(body_box, True, True, 0)

        # Left: Cairo Map Area
        map_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        map_card.get_style_context().add_class("side-card")
        map_card.set_hexpand(True)
        map_card.set_vexpand(True)

        self.map_area = Gtk.DrawingArea()
        self.map_area.set_size_request(600, 360)
        self.map_area.connect("draw", self.on_draw_map)
        map_card.pack_start(self.map_area, True, True, 0)
        body_box.pack_start(map_card, True, True, 0)

        # Right: Telemetry Controls & Registers
        right_panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right_panel.set_size_request(300, -1)
        body_box.pack_start(right_panel, False, False, 0)

        # Register Card 1: Coordinates & Altitude
