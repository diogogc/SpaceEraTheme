    def build_ui(self):
        self.set_name("main-window")
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # Header Panel
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class("header-panel")

        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        title = Gtk.Label(label="🛰️ ISS ORBITAL TELEMETRY // MISSION CONTROL CONSOLE")
        title.set_xalign(0.0)
        title.get_style_context().add_class("header-title")
        title_box.pack_start(title, True, True, 0)

        btn_close = Gtk.Button(label="[ ESC ]")
        btn_close.get_style_context().add_class("close-btn")
        btn_close.connect("clicked", lambda b: self.close_window())
        title_box.pack_end(btn_close, False, False, 0)

        header.pack_start(title_box, False, False, 0)

        sub = Gtk.Label(label="APOLLO GUIDANCE TELEMETRY & WORLD PROJECTION // NORAD CAT ID: 25544")
        sub.set_xalign(0.0)
        sub.get_style_context().add_class("header-sub")
        header.pack_start(sub, False, False, 0)

        main_box.pack_start(header, False, False, 0)

        # Tab Switcher Bar
        tab_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        tab_bar.get_style_context().add_class("tab-bar")

        self.btn_tab_iss = Gtk.Button(label="⌖ ISS ORBIT & TRACKING")
        self.btn_tab_iss.get_style_context().add_class("tab-btn")
        self.btn_tab_iss.get_style_context().add_class("tab-btn-active")
        self.btn_tab_iss.connect("clicked", lambda b: self.switch_tab("iss"))
        tab_bar.pack_start(self.btn_tab_iss, False, False, 0)

        self.btn_tab_launches = Gtk.Button(label="🚀 7-DAY LAUNCHES")
        self.btn_tab_launches.get_style_context().add_class("tab-btn")
        self.btn_tab_launches.connect("clicked", lambda b: self.switch_tab("launches"))
        tab_bar.pack_start(self.btn_tab_launches, False, False, 0)

        main_box.pack_start(tab_bar, False, False, 0)

        # Stack for View Switching
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        main_box.pack_start(self.stack, True, True, 0)

        # Central Split Body: Map Area (Left) + Telemetry Instrumentation (Right)
        body_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        body_box.set_margin_start(12)
        body_box.set_margin_end(12)
        body_box.set_margin_top(8)
        body_box.set_margin_bottom(8)
        self.stack.add_named(body_box, "iss")

        # 7-Day Launches View
        launches_box = self.build_launches_ui()
        self.stack.add_named(launches_box, "launches")

        # Left: Cairo Map Area
        map_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        map_card.get_style_context().add_class("side-card")
        map_card.set_hexpand(True)
        map_card.set_vexpand(True)

        self.map_area = Gtk.DrawingArea()
        self.map_area.set_size_request(600, 360)
        self.map_area.connect("draw", self.on_draw_map)
        map_card.pack_start(self.map_area, True, True, 0)
        body_box.pack_start(map_card, True, True, 0)

        # Right: Telemetry Controls & Registers
        right_panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right_panel.set_size_request(300, -1)
        body_box.pack_start(right_panel, False, False, 0)

        # Register Card 1: Coordinates & Altitude
        card_pos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        card_pos.get_style_context().add_class("side-card")
        
        lbl_p_title = Gtk.Label(label="ORBITAL POSITION & ALTITUDE")
        lbl_p_title.set_xalign(0.0)
        lbl_p_title.get_style_context().add_class("reg-title")
        card_pos.pack_start(lbl_p_title, False, False, 0)

        self.lbl_coords = Gtk.Label(label="--° --°")
        self.lbl_coords.set_xalign(0.0)
        self.lbl_coords.get_style_context().add_class("reg-value")
        card_pos.pack_start(self.lbl_coords, False, False, 0)

        self.lbl_alt_vel = Gtk.Label(label="ALT: --- km // VEL: --- km/h (Mach --)")
        self.lbl_alt_vel.set_xalign(0.0)
        self.lbl_alt_vel.get_style_context().add_class("reg-sub")
        card_pos.pack_start(self.lbl_alt_vel, False, False, 0)
        right_panel.pack_start(card_pos, False, False, 0)

        # Register Card 2: Pass Prediction & Footprint
        card_pass = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        card_pass.get_style_context().add_class("side-card")

        lbl_pass_title = Gtk.Label(label="BASE LOCATION & PASS STATUS")
        lbl_pass_title.set_xalign(0.0)
        lbl_pass_title.get_style_context().add_class("reg-title")
        card_pass.pack_start(lbl_pass_title, False, False, 0)

        self.lbl_base_loc = Gtk.Label(label="BASE: NOT CONFIGURED")
        self.lbl_base_loc.set_xalign(0.0)
        self.lbl_base_loc.get_style_context().add_class("reg-value")
        self.lbl_base_loc.set_line_wrap(True)
        card_pass.pack_start(self.lbl_base_loc, False, False, 0)

        self.lbl_pass_time = Gtk.Label(label="NEXT PASS: NO PASS IN 24H")
        self.lbl_pass_time.set_xalign(0.0)
        self.lbl_pass_time.get_style_context().add_class("reg-sub")
        card_pass.pack_start(self.lbl_pass_time, False, False, 0)

        self.lbl_pass_flare = Gtk.Label(label="SIGHTING: STANDBY")
        self.lbl_pass_flare.set_xalign(0.0)
        self.lbl_pass_flare.get_style_context().add_class("reg-sub")
        card_pass.pack_start(self.lbl_pass_flare, False, False, 0)

        self.lbl_pass_status = Gtk.Label(label="STATUS: STANDBY")
        self.lbl_pass_status.set_xalign(0.0)
        self.lbl_pass_status.get_style_context().add_class("status-badge")
        self.lbl_pass_status.get_style_context().add_class("status-nominal")
        card_pass.pack_start(self.lbl_pass_status, False, False, 0)
        right_panel.pack_start(card_pass, False, False, 0)

        # Config Card 3: City Configurator
        card_cfg = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card_cfg.get_style_context().add_class("side-card")

        lbl_c_title = Gtk.Label(label="SET HOME BASE CITY")
        lbl_c_title.set_xalign(0.0)
        lbl_c_title.get_style_context().add_class("reg-title")
        card_cfg.pack_start(lbl_c_title, False, False, 0)

        self.entry_city = Gtk.Entry()
        self.entry_city.set_placeholder_text("Enter City (e.g. Houston, London)...")
        self.entry_city.connect("activate", self.on_set_city)
        card_cfg.pack_start(self.entry_city, False, False, 0)

        btn_grid = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        btn_set = Gtk.Button(label="[ SET ]")
        btn_set.get_style_context().add_class("action-btn")
        btn_set.connect("clicked", self.on_set_city)
        btn_grid.pack_start(btn_set, True, True, 0)

        btn_clear = Gtk.Button(label="[ CLEAR ]")
        btn_clear.get_style_context().add_class("action-btn")
        btn_clear.connect("clicked", self.on_clear_city)
        btn_grid.pack_start(btn_clear, True, True, 0)

        btn_refresh = Gtk.Button(label="[ 🔄 TLE ]")
        btn_refresh.get_style_context().add_class("action-btn")
        btn_refresh.connect("clicked", self.on_refresh_tle)
        btn_grid.pack_start(btn_refresh, True, True, 0)

        card_cfg.pack_start(btn_grid, False, False, 0)
        right_panel.pack_start(card_cfg, False, False, 0)

        # Footer Status
        self.lbl_footer = Gtk.Label(label="TLE: ACTIVE // PROJECTION: 19-NODE ORBIT TRACK // [ESC] TO EXIT")
        self.lbl_footer.set_xalign(0.0)
        self.lbl_footer.get_style_context().add_class("status-bar")
        main_box.pack_end(self.lbl_footer, False, False, 0)

    def build_launches_ui(self):
        t = self.theme
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_start(12)
        box.set_margin_end(12)
        box.set_margin_top(6)
        box.set_margin_bottom(8)

        # Top Control Sub-header
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        top_bar.get_style_context().add_class("side-card")

        lbl_hdr = Gtk.Label(label="🚀 UPCOMING 7-DAY SPACE LAUNCH MANIFEST")
        lbl_hdr.set_xalign(0.0)
        lbl_hdr.get_style_context().add_class("reg-title")
        top_bar.pack_start(lbl_hdr, False, False, 0)

        self.lbl_launches_sync = Gtk.Label(label="SYNC: PENDING")
        self.lbl_launches_sync.get_style_context().add_class("reg-sub")
        top_bar.pack_end(self.lbl_launches_sync, False, False, 4)

        btn_ref_launches = Gtk.Button(label="[ ⟳ REFRESH LAUNCHES ]")
        btn_ref_launches.get_style_context().add_class("action-btn")
        btn_ref_launches.connect("clicked", self.on_refresh_launches)
        top_bar.pack_end(btn_ref_launches, False, False, 0)

        box.pack_start(top_bar, False, False, 0)

        # Split Body: Left (Map + Mission Overlay) + Right (Scrolled Mission List)
        split_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

        # Left Column: Map & Mission HUD Overlay
        left_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left_col.set_hexpand(True)
        left_col.set_vexpand(True)

        map_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        map_card.get_style_context().add_class("side-card")
        map_card.set_hexpand(True)
        map_card.set_vexpand(True)

        self.launch_map_area = Gtk.DrawingArea()
        self.launch_map_area.set_size_request(540, 240)
        self.launch_map_area.connect("draw", self.on_draw_launch_map)
        map_card.pack_start(self.launch_map_area, True, True, 0)
        left_col.pack_start(map_card, True, True, 0)

        # Mission HUD Overlay Card
        self.hud_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.hud_card.get_style_context().add_class("side-card")

        # HUD Row 1: Fav Button + Mission Name + Status Badge
        r1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.hud_btn_fav = Gtk.Button(label="☆ FAVORITE")
        self.hud_btn_fav.get_style_context().add_class("fav-btn")
        self.hud_btn_fav.connect("clicked", lambda b: self.on_hud_toggle_fav())
        r1.pack_start(self.hud_btn_fav, False, False, 0)

        self.lbl_hud_name = Gtk.Label(label="SELECT A MISSION")
        self.lbl_hud_name.set_xalign(0.0)
        self.lbl_hud_name.set_ellipsize(Pango.EllipsizeMode.END)
        self.lbl_hud_name.set_max_width_chars(32)
        self.lbl_hud_name.get_style_context().add_class("reg-title")
        r1.pack_start(self.lbl_hud_name, True, True, 0)

        self.lbl_hud_status = Gtk.Label(label=" STANDBY ")
        self.lbl_hud_status.get_style_context().add_class("status-badge")
        self.lbl_hud_status.get_style_context().add_class("status-badge-go")
        r1.pack_end(self.lbl_hud_status, False, False, 0)
        self.hud_card.pack_start(r1, False, False, 0)

        # HUD Row 2: Provider/Pad & Live Countdown
        r2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        col_meta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)

        self.lbl_hud_rocket = Gtk.Label(label="Provider • Rocket")
        self.lbl_hud_rocket.set_xalign(0.0)
        self.lbl_hud_rocket.set_ellipsize(Pango.EllipsizeMode.END)
        self.lbl_hud_rocket.set_max_width_chars(36)
        self.lbl_hud_rocket.get_style_context().add_class("reg-value")
        self.lbl_hud_rocket.get_style_context().add_class("reg-title")
        col_meta.pack_start(self.lbl_hud_rocket, False, False, 0)

        self.lbl_hud_pad = Gtk.Label(label="Pad • Location")
        self.lbl_hud_pad.set_xalign(0.0)
        self.lbl_hud_pad.set_ellipsize(Pango.EllipsizeMode.END)
        self.lbl_hud_pad.set_max_width_chars(40)
        self.lbl_hud_pad.get_style_context().add_class("reg-sub")
        col_meta.pack_start(self.lbl_hud_pad, False, False, 0)
        r2.pack_start(col_meta, True, True, 0)

        cd_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        cd_box.get_style_context().add_class("countdown-box")
        self.lbl_hud_cd = Gtk.Label(label="⏱ T- --:--:--")
        self.lbl_hud_cd.get_style_context().add_class("reg-value")
        cd_box.pack_start(self.lbl_hud_cd, False, False, 0)
        r2.pack_end(cd_box, False, False, 0)
        self.hud_card.pack_start(r2, False, False, 0)

        # HUD Row 3: Pad Coordinates & Scheduled UTC
        r3 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.lbl_hud_coords = Gtk.Label(label="PAD COORDS: --")
        self.lbl_hud_coords.set_xalign(0.0)
        self.lbl_hud_coords.get_style_context().add_class("reg-sub")
        r3.pack_start(self.lbl_hud_coords, False, False, 0)

        self.lbl_hud_net = Gtk.Label(label="SCHEDULED: --")
        self.lbl_hud_net.get_style_context().add_class("reg-sub")
        r3.pack_end(self.lbl_hud_net, False, False, 0)
        self.hud_card.pack_start(r3, False, False, 0)

        left_col.pack_start(self.hud_card, False, False, 0)
        split_box.pack_start(left_col, True, True, 0)

        # Right Column: Scrolled Launch Cards List
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_size_request(420, -1)
        scroller.set_vexpand(True)

        self.launches_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        scroller.add(self.launches_container)
        split_box.pack_start(scroller, False, False, 0)

        box.pack_start(split_box, True, True, 0)
        return box

    def switch_tab(self, tab_id):
        self.current_tab = tab_id
        self.stack.set_visible_child_name(tab_id)
        if tab_id == "iss":
            self.btn_tab_iss.get_style_context().add_class("tab-btn-active")
            self.btn_tab_launches.get_style_context().remove_class("tab-btn-active")
            self.lbl_footer.set_text("TLE: ACTIVE // PROJECTION: 19-NODE ORBIT TRACK // [ESC] TO EXIT")
        else:
            self.btn_tab_launches.get_style_context().add_class("tab-btn-active")
            self.btn_tab_iss.get_style_context().remove_class("tab-btn-active")
            self.lbl_footer.set_text("LAUNCH MANIFEST: LAUNCH LIBRARY 2 FEED // AUTO-SYNC 24H // [ESC] TO EXIT")
            if hasattr(self, 'launch_map_area'):
                self.launch_map_area.queue_draw()

    def update_telemetry_ui(self):
        d = self.telemetry
        if not d.get("ok"):
            self.lbl_coords.set_text("OFFLINE")
            self.lbl_alt_vel.set_text("Waiting for orbital feed...")
            return

        lat = float(d.get("latitude", 0))
        lon = float(d.get("longitude", 0))
        alt = float(d.get("altitude", 0))
        vel = float(d.get("velocity", 0))
        vis = str(d.get("visibility", "unknown")).upper()
        mach = vel / 1234.8

        lat_d = "N" if lat >= 0 else "S"
        lon_d = "E" if lon >= 0 else "W"
        self.lbl_coords.set_text(f"{abs(lat):.2f}°{lat_d}  {abs(lon):.2f}°{lon_d}")
        self.lbl_alt_vel.set_text(f"ALT: {alt:.1f} km // VEL: {vel:,.0f} km/h (M{mach:.1f}) // {vis}")

        loc = d.get("user_location", {})
        if loc.get("configured"):
            self.lbl_base_loc.set_text(loc.get("city", "HOME BASE"))
        else:
            self.lbl_base_loc.set_text("BASE: NOT CONFIGURED")

        np = d.get("next_pass", {})
        if np.get("available"):
            cd = np.get("countdown", 0)
            hrs = cd // 3600
            mins = (cd % 3600) // 60
            dur = np.get("duration", 0)
            self.lbl_pass_time.set_text(f"NEXT PASS: in {hrs}h {mins:02d}m (Dur: {dur//60}m {dur%60:02d}s)")
            fl = np.get("flare", {})
            self.lbl_pass_flare.set_text(f"OPTICAL: {fl.get('label', 'Radio Only')}")

            if np.get("current"):
                self.lbl_pass_status.set_text("STATUS: [ ⚡ ISS ACQUIRED IN FOOTPRINT ]")
                self.lbl_pass_status.get_style_context().remove_class("status-nominal")
                self.lbl_pass_status.get_style_context().add_class("status-acquired")
            else:
                self.lbl_pass_status.set_text("STATUS: [ TRACKING NOMINAL ]")
                self.lbl_pass_status.get_style_context().remove_class("status-acquired")
                self.lbl_pass_status.get_style_context().add_class("status-nominal")
        else:
            self.lbl_pass_time.set_text("NEXT PASS: NO PASS IN 24H")
            self.lbl_pass_flare.set_text("OPTICAL: STANDBY")
            self.lbl_pass_status.set_text("STATUS: [ OUT OF FOOTPRINT RANGE ]")
            self.lbl_pass_status.get_style_context().remove_class("status-acquired")
            self.lbl_pass_status.get_style_context().add_class("status-nominal")

        self.update_launches_ui()

    def update_launches_ui(self):
        d = self.telemetry
        launches_info = d.get("launches_info", {})
        launches = launches_info.get("launches", [])
        count = len(launches)
        self.btn_tab_launches.set_label(f"🚀 7-DAY LAUNCHES ({count})")

        fat = launches_info.get("fetched_at", 0)
        if fat > 0:
            diff = max(0, int(time.time()) - fat)
            if diff < 60:
                ago = "Just now"
            elif diff < 3600:
                ago = f"{diff // 60}m ago"
            elif diff < 86400:
                ago = f"{diff // 3600}h ago"
            else:
                ago = f"{diff // 86400}d ago"
            self.lbl_launches_sync.set_text(f"SYNCED: {ago.upper()}")
        else:
            self.lbl_launches_sync.set_text("SYNC: PENDING")

        # Check if launches payload actually changed to prevent rebuilding GTK tree and causing flicker
        cur_hash = json.dumps([(l.get("id"), l.get("name"), l.get("net"), l.get("is_favorite"), l.get("status")) for l in launches])
        if cur_hash == self.last_launches_hash and count > 0:
            # Data did not change; just update overlay & live countdowns
            self.update_hud_overlay()
            self.update_live_countdowns()
            return

        self.last_launches_hash = cur_hash

        for child in self.launches_container.get_children():
            self.launches_container.remove(child)
        self.countdown_items.clear()
        self.card_boxes.clear()

        if count == 0:
            empty_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            empty_card.get_style_context().add_class("launch-card")
            lbl_e = Gtk.Label(label="NO SCHEDULED LAUNCHES FOUND IN THE NEXT 7 DAYS")
            lbl_e.get_style_context().add_class("reg-sub")
            empty_card.pack_start(lbl_e, True, True, 20)
            self.launches_container.pack_start(empty_card, False, False, 0)
            self.launches_container.show_all()
            return

        # Select first launch by default if none selected or selected disappeared
        selected_found = False
        for l in launches:
            if l.get("id") == self.selected_launch_id:
                self.selected_launch_data = l
                selected_found = True
                break
        if not selected_found and launches:
            self.selected_launch_id = launches[0].get("id")
            self.selected_launch_data = launches[0]

        self.update_hud_overlay()

        for item in launches:
            lid = item.get("id")
            is_selected = (lid == self.selected_launch_id)
            card = Gtk.EventBox()
            card_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            card_box.get_style_context().add_class("launch-card")
            if is_selected:
                card_box.get_style_context().add_class("launch-card-selected")
            card.add(card_box)
            self.card_boxes[lid] = card_box

            # Row 1: Fav Button + Mission Name + Status Badge
            r1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            
            btn_fav = Gtk.Button(label="★" if item.get("is_favorite") else "☆")
            btn_fav.get_style_context().add_class("fav-btn")
            if item.get("is_favorite"):
                btn_fav.get_style_context().add_class("fav-btn-active")
            btn_fav.connect("clicked", lambda b, target_id=lid: self.on_toggle_fav(target_id))
            r1.pack_start(btn_fav, False, False, 0)

            lbl_name = Gtk.Label(label=f"🚀 {item.get('name', 'Unknown Launch')}")
            lbl_name.set_xalign(0.0)
            lbl_name.set_ellipsize(Pango.EllipsizeMode.END)
            lbl_name.set_max_width_chars(28)
            lbl_name.get_style_context().add_class("reg-title")
            r1.pack_start(lbl_name, True, True, 0)

            status_str = item.get("status", "Unknown")
            lbl_status = Gtk.Label(label=f" {status_str.upper()} ")
            lbl_status.get_style_context().add_class("status-badge")
            if "Go" in status_str:
                lbl_status.get_style_context().add_class("status-badge-go")
            else:
                lbl_status.get_style_context().add_class("status-badge-tbc")
            r1.pack_end(lbl_status, False, False, 0)
            card_box.pack_start(r1, False, False, 0)

            # Row 2: Provider/Pad + Countdown
            r2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            col_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lbl_prov = Gtk.Label(label=f"{item.get('provider', '')} • {item.get('rocket', '')}")
            lbl_prov.set_xalign(0.0)
            lbl_prov.set_ellipsize(Pango.EllipsizeMode.END)
            lbl_prov.set_max_width_chars(30)
            lbl_prov.get_style_context().add_class("reg-sub")
            col_info.pack_start(lbl_prov, False, False, 0)

            pad_loc = item.get('pad', '')
            if item.get('location'):
                pad_loc += f" • {item.get('location')}"
            lbl_pad = Gtk.Label(label=pad_loc)
            lbl_pad.set_xalign(0.0)
            lbl_pad.set_ellipsize(Pango.EllipsizeMode.END)
            lbl_pad.set_max_width_chars(34)
            lbl_pad.get_style_context().add_class("reg-sub")
            col_info.pack_start(lbl_pad, False, False, 0)
            r2.pack_start(col_info, True, True, 0)

            # Countdown Box
            cd_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            cd_box.get_style_context().add_class("countdown-box")
            lbl_cd = Gtk.Label(label="⏱ T- --:--:--")
            lbl_cd.get_style_context().add_class("reg-value")
            cd_box.pack_start(lbl_cd, False, False, 0)
            r2.pack_end(cd_box, False, False, 0)

            net_ts = item.get("net_ts", 0)
            self.countdown_items.append((lbl_cd, net_ts))
            card_box.pack_start(r2, False, False, 0)

            # Row 3: Scheduled Date + Orbit Tag
            r3 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            net_str = item.get("net", "")
            lbl_sched = Gtk.Label(label=f"SCHEDULED: {net_str}")
            lbl_sched.set_xalign(0.0)
            lbl_sched.set_ellipsize(Pango.EllipsizeMode.END)
            lbl_sched.set_max_width_chars(32)
            lbl_sched.get_style_context().add_class("reg-sub")
            r3.pack_start(lbl_sched, False, False, 0)

            orbit_str = item.get("orbit", "")
            if orbit_str:
                lbl_orb = Gtk.Label(label=f"ORBIT: {orbit_str}")
                lbl_orb.get_style_context().add_class("reg-sub")
                r3.pack_end(lbl_orb, False, False, 0)

            card_box.pack_start(r3, False, False, 0)

            # Click handler to select launch
            card.connect("button-press-event", lambda w, e, l=item: self.select_launch(l))

            self.launches_container.pack_start(card, False, False, 0)

        self.launches_container.show_all()
        self.update_live_countdowns()
        if hasattr(self, 'launch_map_area'):
            self.launch_map_area.queue_draw()

    def update_hud_overlay(self):
        item = self.selected_launch_data
        if not item:
            return

        is_fav = item.get("is_favorite", False)
        self.hud_btn_fav.set_label("★ FAVORITED" if is_fav else "☆ FAVORITE")
        if is_fav:
            self.hud_btn_fav.get_style_context().add_class("fav-btn-active")
        else:
            self.hud_btn_fav.get_style_context().remove_class("fav-btn-active")

        self.lbl_hud_name.set_text(f"🚀 {item.get('name', 'Unknown Mission')}")
        status_str = item.get("status", "Unknown")
        self.lbl_hud_status.set_text(f" {status_str.upper()} ")
        if "Go" in status_str:
            self.lbl_hud_status.get_style_context().remove_class("status-badge-tbc")
            self.lbl_hud_status.get_style_context().add_class("status-badge-go")
        else:
            self.lbl_hud_status.get_style_context().remove_class("status-badge-go")
            self.lbl_hud_status.get_style_context().add_class("status-badge-tbc")

        self.lbl_hud_rocket.set_text(f"{item.get('provider', '')} • {item.get('rocket', '')}")
        pad_loc = item.get('pad', '')
        if item.get('location'):
            pad_loc += f" • {item.get('location')}"
        self.lbl_hud_pad.set_text(pad_loc)

        plat = item.get("pad_lat")
        plon = item.get("pad_lon")
        if plat is not None and plon is not None:
            lat_d = "N" if float(plat) >= 0 else "S"
            lon_d = "E" if float(plon) >= 0 else "W"
            self.lbl_hud_coords.set_text(f"PAD COORDS: {abs(float(plat)):.2f}°{lat_d}  {abs(float(plon)):.2f}°{lon_d}")
        else:
            self.lbl_hud_coords.set_text("PAD COORDS: UNLISTED")

        self.lbl_hud_net.set_text(f"SCHEDULED: {item.get('net', '')}")

    def select_launch(self, item):
        self.selected_launch_id = item.get("id")
        self.selected_launch_data = item
        self.update_hud_overlay()
        self.update_live_countdowns()

        # Update card highlight visually without rebuilding tree
        for lid, box in self.card_boxes.items():
            if lid == self.selected_launch_id:
                box.get_style_context().add_class("launch-card-selected")
            else:
                box.get_style_context().remove_class("launch-card-selected")

        if hasattr(self, 'launch_map_area'):
            self.launch_map_area.queue_draw()

    def on_hud_toggle_fav(self):
        if self.selected_launch_id:
            self.on_toggle_fav(self.selected_launch_id)

    def on_toggle_fav(self, launch_id):
        if not launch_id:
            return
        subprocess.run([TRACKER_BIN, "--toggle-fav", launch_id], check=False)
        subprocess.run(["space-quindar", "beep"], check=False)
        self.last_launches_hash = "" # force UI refresh
        self.fetch_telemetry()

    def update_live_countdowns(self):
        now = int(time.time())
        # Update HUD countdown
        if self.selected_launch_data:
            net_ts = self.selected_launch_data.get("net_ts", 0)
            if not net_ts or net_ts <= 0:
                self.lbl_hud_cd.set_text("T- PENDING")
            else:
                diff = net_ts - now
                if diff < -7200:
                    self.lbl_hud_cd.set_text("LAUNCHED")
                elif diff < 0:
                    abs_d = abs(diff)
                    m = (abs_d % 3600) // 60
                    s = abs_d % 60
                    self.lbl_hud_cd.set_text(f"T+ {m:02d}m {s:02d}s")
                else:
                    days = diff // 86400
                    hours = (diff % 86400) // 3600
                    mins = (diff % 3600) // 60
                    secs = diff % 60
                    if days > 0:
                        self.lbl_hud_cd.set_text(f"⏱ T- {days}d {hours:02d}h {mins:02d}m {secs:02d}s")
                    else:
                        self.lbl_hud_cd.set_text(f"⏱ T- {hours:02d}h {mins:02d}m {secs:02d}s")

        for lbl, net_ts in self.countdown_items:
            if not net_ts or net_ts <= 0:
                lbl.set_text("T- PENDING")
                continue
            diff = net_ts - now
            if diff < -7200:
                lbl.set_text("LAUNCHED")
            elif diff < 0:
                abs_d = abs(diff)
                m = (abs_d % 3600) // 60
                s = abs_d % 60
                lbl.set_text(f"T+ {m:02d}m {s:02d}s")
            else:
                days = diff // 86400
                hours = (diff % 86400) // 3600
                mins = (diff % 3600) // 60
                secs = diff % 60
                if days > 0:
                    lbl.set_text(f"⏱ T- {days}d {hours:02d}h {mins:02d}m {secs:02d}s")
                else:
                    lbl.set_text(f"⏱ T- {hours:02d}h {mins:02d}m {secs:02d}s")

    def on_draw_launch_map(self, widget, cr):
        t = self.theme
        avail_w = widget.get_allocated_width()
        avail_h = widget.get_allocated_height()

        cr.set_source_rgb(0.02, 0.03, 0.05)
        cr.paint()

        target_aspect = 2.0
        pad = 6.0
        canvas_w = max(10.0, avail_w - 2 * pad)
        canvas_h = max(10.0, avail_h - 2 * pad)

        if canvas_w / canvas_h > target_aspect:
            map_h = canvas_h
            map_w = map_h * target_aspect
        else:
            map_w = canvas_w
            map_h = map_w / target_aspect

        offset_x = pad + (canvas_w - map_w) / 2.0
        offset_y = pad + (canvas_h - map_h) / 2.0

        def map_coords(lon, lat):
            x = offset_x + ((lon + 180.0) / 360.0) * map_w
            y = offset_y + ((90.0 - lat) / 180.0) * map_h
            return x, y

        cr.save()
        cr.rectangle(offset_x, offset_y, map_w, map_h)
        cr.clip()

        cr.set_source_rgb(t['map_ocean'][0], t['map_ocean'][1], t['map_ocean'][2])
        cr.rectangle(offset_x, offset_y, map_w, map_h)
        cr.fill()

        # Grid lines
        cr.set_source_rgba(t['map_grid'][0], t['map_grid'][1], t['map_grid'][2], 0.25)
        cr.set_line_width(0.5)
        for g_lon in range(-180, 181, 30):
            gx, gy1 = map_coords(g_lon, 90)
            _, gy2 = map_coords(g_lon, -90)
            cr.move_to(gx, gy1)
            cr.line_to(gx, gy2)
            cr.stroke()

        for g_lat in range(-90, 91, 30):
            gx1, gy = map_coords(-180, g_lat)
            gx2, _ = map_coords(180, g_lat)
            cr.move_to(gx1, gy)
            cr.line_to(gx2, gy)
            cr.stroke()

        # Coastlines
        cr.set_source_rgb(t['map_coast'][0], t['map_coast'][1], t['map_coast'][2])
        cr.set_line_width(0.85)
        for poly in self.coastlines:
            if not poly or len(poly) < 2:
                continue
            fx, fy = map_coords(poly[0][0], poly[0][1])
            cr.move_to(fx, fy)
            prev_pt = poly[0]
            for pt in poly[1:]:
                px, py = map_coords(pt[0], pt[1])
                if abs(pt[0] - prev_pt[0]) < 180:
                    cr.line_to(px, py)
                else:
                    cr.move_to(px, py)
                prev_pt = pt
            cr.stroke()

        # Draw Selected Launch Pad Pin & Pulsing Target Crosshairs
        item = self.selected_launch_data
        if item and item.get("pad_lat") is not None and item.get("pad_lon") is not None:
            plat = float(item["pad_lat"])
            plon = float(item["pad_lon"])
            lx, ly = map_coords(plon, plat)

            # Pulsing target ring
            pulse_r = 7.0 + 3.5 * math.sin(self.pulse_phase)
            cr.set_source_rgba(1.0, 0.7, 0.0, 0.35)
            cr.arc(lx, ly, pulse_r, 0, 2 * math.pi)
            cr.fill()

            # Outer ring
            cr.set_source_rgb(1.0, 0.7, 0.0)
            cr.set_line_width(1.3)
            cr.arc(lx, ly, 7.5, 0, 2 * math.pi)
            cr.stroke()

            # Crosshairs
            cr.move_to(lx - 12, ly)
            cr.line_to(lx + 12, ly)
            cr.move_to(lx, ly - 12)
            cr.line_to(lx, ly + 12)
            cr.stroke()

            # Core pin
            cr.arc(lx, ly, 3.0, 0, 2 * math.pi)
            cr.fill()

        cr.restore()

    def on_refresh_launches(self, widget):
        self.lbl_footer.set_text("FETCHING UPCOMING LAUNCHES FROM LAUNCH LIBRARY 2...")
        subprocess.run([TRACKER_BIN, "--fetch-launches"], check=False)
        subprocess.run(["space-quindar", "beep"], check=False)
        self.fetch_telemetry()



    def on_draw_map(self, widget, cr):
        t = self.theme
        avail_w = widget.get_allocated_width()
        avail_h = widget.get_allocated_height()

        # Canvas Outer Background
        cr.set_source_rgb(0.02, 0.03, 0.05)
        cr.paint()

        # Strict 2:1 Equirectangular Aspect Ratio (360° Lon : 180° Lat)
        target_aspect = 2.0
        pad = 6.0
        canvas_w = max(10.0, avail_w - 2 * pad)
        canvas_h = max(10.0, avail_h - 2 * pad)

        if canvas_w / canvas_h > target_aspect:
            map_h = canvas_h
            map_w = map_h * target_aspect
        else:
            map_w = canvas_w
            map_h = map_w / target_aspect

        map_x0 = pad + (canvas_w - map_w) / 2.0
        map_y0 = pad + (canvas_h - map_h) / 2.0

        def map_coords(lon, lat):
            x = map_x0 + ((lon + 180.0) / 360.0) * map_w
            y = map_y0 + ((90.0 - lat) / 180.0) * map_h
            return x, y

        # 1. Map Frame & Ocean Background
        cr.save()
        cr.rectangle(map_x0, map_y0, map_w, map_h)
        cr.set_source_rgb(0.04, 0.06, 0.09)
        cr.fill_preserve()
        cr.set_source_rgba(0.2, 0.3, 0.45, 0.8)
        cr.set_line_width(1.0)
        cr.stroke()
        cr.restore()

        # Clip all rendering strictly inside the 2:1 map rectangle
        cr.save()
        cr.rectangle(map_x0, map_y0, map_w, map_h)
        cr.clip()

        # 2. Draw Lat/Lon Grid Lines
        cr.set_source_rgba(t['map_grid'][0], t['map_grid'][1], t['map_grid'][2], 0.7)
        cr.set_line_width(0.7)
        for lat_g in [-60, -30, 0, 30, 60]:
            _, y = map_coords(0, lat_g)
            cr.move_to(map_x0, y)
            cr.line_to(map_x0 + map_w, y)
            cr.stroke()
        for lon_g in [-120, -60, 0, 60, 120]:
            x, _ = map_coords(lon_g, 0)
            cr.move_to(x, map_y0)
            cr.line_to(x, map_y0 + map_h)
            cr.stroke()

        # Equator & Prime Meridian Emphasis
        cr.set_source_rgba(t['map_coast'][0], t['map_coast'][1], t['map_coast'][2], 0.4)
        _, eq_y = map_coords(0, 0)
        cr.move_to(map_x0, eq_y)
        cr.line_to(map_x0 + map_w, eq_y)
        cr.stroke()

        # 3. Draw Coastlines
        cr.set_source_rgb(t['map_coast'][0], t['map_coast'][1], t['map_coast'][2])
        cr.set_line_width(0.85)
        for poly in self.coastlines:
            if not poly or len(poly) < 2:
                continue
            fx, fy = map_coords(poly[0][0], poly[0][1])
            cr.move_to(fx, fy)
            prev_pt = poly[0]
            for pt in poly[1:]:
                px, py = map_coords(pt[0], pt[1])
                # Prevent wrap lines across antimeridian
                if abs(pt[0] - prev_pt[0]) < 180:
                    cr.line_to(px, py)
                else:
                    cr.move_to(px, py)
                prev_pt = pt
            cr.stroke()

        d = self.telemetry
        if d.get("ok"):
            # 4. Draw 19-Point Orbit Ground Track Projection
            orbit = d.get("orbit", [])
            if len(orbit) >= 2:
                cr.set_source_rgba(t['orbit_color'][0], t['orbit_color'][1], t['orbit_color'][2], 0.8)
                cr.set_dash([4.0, 3.0])
                cr.set_line_width(1.3)
                for i in range(len(orbit) - 1):
                    p1 = orbit[i]
                    p2 = orbit[i + 1]
                    x1, y1 = map_coords(p1["longitude"], p1["latitude"])
                    x2, y2 = map_coords(p2["longitude"], p2["latitude"])
                    # Avoid antimeridian wrap jump
                    if abs(p2["longitude"] - p1["longitude"]) < 180:
                        cr.move_to(x1, y1)
                        cr.line_to(x2, y2)
                        cr.stroke()
                cr.set_dash([])

            # 5. Draw Home Base Location
            loc = d.get("user_location", {})
            if loc.get("configured"):
                hx, hy = map_coords(loc["longitude"], loc["latitude"])
                cr.set_source_rgb(t['home_color'][0], t['home_color'][1], t['home_color'][2])
                cr.arc(hx, hy, 3.5, 0, 2 * math.pi)
                cr.fill()
                cr.arc(hx, hy, 7.5, 0, 2 * math.pi)
                cr.set_line_width(1.0)
                cr.stroke()

                # Target Pin Crosshairs
                cr.move_to(hx - 9, hy)
                cr.line_to(hx + 9, hy)
                cr.move_to(hx, hy - 9)
                cr.line_to(hx, hy + 9)
                cr.stroke()

            # 6. Draw ISS Visibility Footprint
            iss_lat = float(d.get("latitude", 0))
            iss_lon = float(d.get("longitude", 0))
            ix, iy = map_coords(iss_lon, iss_lat)

            footprint_rad_px = (2200.0 / 40075.0) * map_w
            cr.set_source_rgba(t['footprint_color'][0], t['footprint_color'][1], t['footprint_color'][2], 0.12)
            cr.arc(ix, iy, footprint_rad_px, 0, 2 * math.pi)
            cr.fill()

            cr.set_source_rgba(t['footprint_color'][0], t['footprint_color'][1], t['footprint_color'][2], 0.6)
            cr.set_line_width(1.0)
            cr.arc(ix, iy, footprint_rad_px, 0, 2 * math.pi)
            cr.stroke()

            # 7. Draw ISS Satellite Marker & Pulsing Beacon
            pulse_r = 5.5 + 3.5 * math.sin(self.pulse_phase)
            cr.set_source_rgba(t['iss_color'][0], t['iss_color'][1], t['iss_color'][2], 0.35)
            cr.arc(ix, iy, pulse_r, 0, 2 * math.pi)
            cr.fill()

            # Core ISS Icon
            cr.set_source_rgb(t['iss_color'][0], t['iss_color'][1], t['iss_color'][2])
            cr.rectangle(ix - 3, iy - 3, 6, 6)
            cr.fill()

            # Solar Panels
            cr.set_line_width(1.2)
            cr.move_to(ix - 7, iy)
            cr.line_to(ix + 7, iy)
            cr.move_to(ix, iy - 7)
            cr.line_to(ix, iy + 7)
            cr.stroke()

        cr.restore()

    def on_set_city(self, widget):
        city = self.entry_city.get_text().strip()
        if city:
            self.lbl_footer.set_text(f"GEOCODING: '{city}'...")
            subprocess.run([TRACKER_BIN, "--set-city", city], check=False)
            subprocess.run(["space-quindar", "outro"], check=False)
            self.entry_city.set_text("")
            self.fetch_telemetry()

    def on_clear_city(self, widget):
        subprocess.run([TRACKER_BIN, "--clear-city"], check=False)
        subprocess.run(["space-quindar", "beep"], check=False)
        self.fetch_telemetry()

    def on_refresh_tle(self, widget):
        self.lbl_footer.set_text("UPDATING TLE FROM CELESTRAK...")
        subprocess.run([TRACKER_BIN, "--fetch-tle"], check=False)
        subprocess.run(["space-quindar", "beep"], check=False)
        self.fetch_telemetry()

    def on_key_press(self, widget, event):
        if event.keyval in [Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Q]:
            self.close_window()
            return True
        return False

    def close_window(self):
        Gtk.main_quit()

def main():
    win = IssConsoleWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
