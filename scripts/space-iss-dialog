        self.lbl_coords.get_style_context().add_class("reg-value")
        card_pos.pack_start(self.lbl_coords, False, False, 0)

        self.lbl_alt_vel = Gtk.Label(label="ALT: --- km // VEL: --- km/h (Mach --)")
        self.lbl_alt_vel.set_xalign(0.0)
        self.lbl_alt_vel.get_style_context().add_class("reg-sub")
