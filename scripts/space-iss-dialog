def get_current_theme():
    theme_file = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.isfile(theme_file):
        try:
            with open(theme_file, "r") as f:
                theme = f.read().strip()
                if theme in THEMES:
                    return theme
        except Exception:
            pass
    return "nasa"

class IssConsoleWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="ISS Mission Control Console")
        self.set_default_size(1020, 620)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_wmclass("space-iss-dialog", "space-iss-dialog")
        self.set_decorated(False)
        self.set_resizable(False)

        self.theme_name = get_current_theme()
        self.theme = THEMES.get(self.theme_name, THEMES["nasa"])

        self.coastlines = self._load_coastlines()
        self.telemetry = {}
        self.pulse_phase = 0.0
        self.current_tab = "iss"
        self.countdown_items = []
        self.selected_launch_id = None
        self.selected_launch_data = None
        self.hud_countdown_item = None
        self.last_launches_hash = ""
        self.card_boxes = {}

        self.apply_theme_css()
        self.build_ui()
        self.connect("key-press-event", self.on_key_press)

        # Initial fetch & timer tick (every 2 seconds)
        self.fetch_telemetry()
        GLib.timeout_add(2000, self._on_timer_tick)
        GLib.timeout_add(100, self._on_pulse_tick)

    def _load_coastlines(self):
        if os.path.isfile(COASTLINES_FILE):
            try:
                with open(COASTLINES_FILE, "r") as f:
                    return json.load(f)
            except Exception:
                pass
        return []

    def fetch_telemetry(self):
        try:
            res = subprocess.run([TRACKER_BIN], capture_output=True, text=True, timeout=5)
            self.telemetry = json.loads(res.stdout.strip())
        except Exception:
            self.telemetry = {"ok": False}
        self.update_telemetry_ui()
        self.map_area.queue_draw()

    def _on_timer_tick(self):
        self.fetch_telemetry()
        return True

    def _on_pulse_tick(self):
        self.pulse_phase = (self.pulse_phase + 0.15) % (2.0 * math.pi)
        if self.current_tab == "iss":
            self.map_area.queue_draw()
        else:
            self.update_live_countdowns()
            if hasattr(self, 'launch_map_area'):
                self.launch_map_area.queue_draw()
        return True

