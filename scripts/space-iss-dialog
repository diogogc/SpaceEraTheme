        card_pos.get_style_context().add_class("side-card")
        
        lbl_p_title = Gtk.Label(label="ORBITAL POSITION & ALTITUDE")
        lbl_p_title.set_xalign(0.0)
        lbl_p_title.get_style_context().add_class("reg-title")
        card_pos.pack_start(lbl_p_title, False, False, 0)

        self.lbl_coords = Gtk.Label(label="--° --°")
