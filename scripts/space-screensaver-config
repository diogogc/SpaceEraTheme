            font-weight: 800;
            padding: 7px 12px;
            border-radius: {t['radius']};
        }}
        button.action-btn:hover {{
            background-color: {t['bg_selected']};
            border: 1px solid {t['accent']};
            color: {t['accent']};
        }}
        button.save-btn {{
            background-color: {t['accent']};
            background-image: none;
            border: 1px solid {t['accent']};
            color: {t['bg_chassis']};
            font-size: 10px;
            font-weight: 900;
            padding: 7px 16px;
            border-radius: {t['radius']};
        }}
        button.save-btn:hover {{
            background-color: {t['text_primary']};
            color: #000000;
        }}
        .status-bar {{
            font-size: 8.5px;
            color: {t['text_dim']};
