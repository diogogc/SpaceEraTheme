            background-color: {t['bg_panel']};
            border-top: 1px solid {t['border_dim']};
        }}
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER
        )

    def build_ui(self):
        self.set_name("main-window")
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # Header Panel
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class("header-panel")
        
        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        title = Gtk.Label(label="MISSION CONTROL // SCREENSAVER & LOCK")
        title.set_xalign(0.0)
        title.get_style_context().add_class("header-title")
        title_box.pack_start(title, True, True, 0)

        btn_close = Gtk.Button(label="[ ESC ]")
        btn_close.get_style_context().add_class("chip-btn")
        btn_close.connect("clicked", lambda b: self.close_window())
        title_box.pack_end(btn_close, False, False, 0)

        header.pack_start(title_box, False, False, 0)

        sub = Gtk.Label(label="DSKY P88 CONFIG // IDLE TIMEOUT & SECURITY PROTOCOLS")
        sub.set_xalign(0.0)
        sub.get_style_context().add_class("header-sub")
        header.pack_start(sub, False, False, 0)

        main_box.pack_start(header, False, False, 0)

        # Content Box
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        content.get_style_context().add_class("content-box")
        main_box.pack_start(content, True, True, 0)

        # Card 1: Idle Timeout (Time before enter)
        card_timeout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card_timeout.get_style_context().add_class("section-card")
        
        lbl_to = Gtk.Label(label="1. IDLE TIMEOUT (TIME BEFORE ENTERING SCREENSAVER)")
        lbl_to.set_xalign(0.0)
        lbl_to.get_style_context().add_class("section-title")
        card_timeout.pack_start(lbl_to, False, False, 0)

        desc_to = Gtk.Label(label="Select inactivity period before activating the 8-bit space screensaver:")
        desc_to.set_xalign(0.0)
        desc_to.get_style_context().add_class("section-desc")
        card_timeout.pack_start(desc_to, False, False, 0)

        # 4x2 Grid of Timeout Chips
        grid_to = Gtk.Grid()
        grid_to.set_column_spacing(6)
        grid_to.set_row_spacing(6)
        grid_to.set_hexpand(True)

        for idx, (mins, label) in enumerate(TIMEOUT_PRESETS):
            btn = Gtk.Button(label=label)
            btn.get_style_context().add_class("chip-btn")
            btn.set_hexpand(True)
            if mins == self.selected_timeout:
                btn.get_style_context().add_class("active")
            btn.connect("clicked", self.on_timeout_clicked, mins)
            self.timeout_buttons[mins] = btn
            grid_to.attach(btn, idx % 4, idx // 4, 1, 1)

        card_timeout.pack_start(grid_to, False, False, 0)
        content.pack_start(card_timeout, False, False, 0)

        # Card 2: Lock PC on Wake
        card_lock = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card_lock.get_style_context().add_class("section-card")

        lbl_lock = Gtk.Label(label="2. SECURITY // REQUIRE PASSWORD TO UNLOCK PC ON WAKE")
        lbl_lock.set_xalign(0.0)
        lbl_lock.get_style_context().add_class("section-title")
        card_lock.pack_start(lbl_lock, False, False, 0)

        desc_lock = Gtk.Label(label="When enabled, dismissing the screensaver immediately locks the screen via hyprlock:")
        desc_lock.set_xalign(0.0)
        desc_lock.get_style_context().add_class("section-desc")
        card_lock.pack_start(desc_lock, False, False, 0)

        self.btn_lock_toggle = Gtk.Button()
        self.btn_lock_toggle.get_style_context().add_class("toggle-btn")
        self.btn_lock_toggle.connect("clicked", self.on_lock_toggle_clicked)
        self.update_lock_toggle_ui()
        card_lock.pack_start(self.btn_lock_toggle, False, False, 0)
        content.pack_start(card_lock, False, False, 0)

        # Card 3: Scene Sequence Mode
        card_scene = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card_scene.get_style_context().add_class("section-card")

        lbl_sc = Gtk.Label(label="3. MISSION SCENE SEQUENCE SELECTION")
        lbl_sc.set_xalign(0.0)
        lbl_sc.get_style_context().add_class("section-title")
        card_scene.pack_start(lbl_sc, False, False, 0)

        desc_sc = Gtk.Label(label="Choose active retro 8-bit animation rotation mode:")
        desc_sc.set_xalign(0.0)
        desc_sc.get_style_context().add_class("section-desc")
        card_scene.pack_start(desc_sc, False, False, 0)

        # 2x2 Grid of Scene Chips
        grid_sc = Gtk.Grid()
        grid_sc.set_column_spacing(6)
        grid_sc.set_row_spacing(6)
        grid_sc.set_hexpand(True)

        for idx, (mode_id, label) in enumerate(SCENE_PRESETS):
            btn = Gtk.Button(label=label)
            btn.get_style_context().add_class("chip-btn")
            btn.set_hexpand(True)
            if mode_id == self.selected_scene:
                btn.get_style_context().add_class("active")
            btn.connect("clicked", self.on_scene_clicked, mode_id)
            self.scene_buttons[mode_id] = btn
            grid_sc.attach(btn, idx % 2, idx // 2, 1, 1)

        card_scene.pack_start(grid_sc, False, False, 0)
        content.pack_start(card_scene, False, False, 0)

        # Buttons Box
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_box.set_margin_top(4)

        btn_test_ss = Gtk.Button(label="[ ⏵ PREVIEW SCREENSAVER ]")
        btn_test_ss.get_style_context().add_class("action-btn")
        btn_test_ss.connect("clicked", lambda b: subprocess.Popen(["space-screensaver"]))
        btn_box.pack_start(btn_test_ss, False, False, 0)

        btn_test_lock = Gtk.Button(label="[ 🔒 TEST HYPRLOCK ]")
        btn_test_lock.get_style_context().add_class("action-btn")
        btn_test_lock.connect("clicked", lambda b: subprocess.Popen(["hyprlock"]))
        btn_box.pack_start(btn_test_lock, False, False, 0)

        self.btn_save = Gtk.Button(label="[ 💾 APPLY & SAVE ]")
        self.btn_save.get_style_context().add_class("save-btn")
        self.btn_save.connect("clicked", self.on_save)
        btn_box.pack_end(self.btn_save, False, False, 0)

        content.pack_start(btn_box, False, False, 0)

        # Status Footer
        self.lbl_status = Gtk.Label(label=f"DAEMON: space-idle-daemon // THEME: {self.theme_name.upper()} // [ESC] TO CLOSE")
        self.lbl_status.set_xalign(0.0)
        self.lbl_status.get_style_context().add_class("status-bar")
        main_box.pack_end(self.lbl_status, False, False, 0)

    def on_timeout_clicked(self, btn, mins):
        self.selected_timeout = mins
        for m, b in self.timeout_buttons.items():
            if m == mins:
                b.get_style_context().add_class("active")
            else:
                b.get_style_context().remove_class("active")

    def on_scene_clicked(self, btn, mode_id):
        self.selected_scene = mode_id
        for s_id, b in self.scene_buttons.items():
            if s_id == mode_id:
                b.get_style_context().add_class("active")
            else:
                b.get_style_context().remove_class("active")

    def on_lock_toggle_clicked(self, btn):
        self.selected_lock = not self.selected_lock
        self.update_lock_toggle_ui()

    def update_lock_toggle_ui(self):
        if self.selected_lock:
            self.btn_lock_toggle.set_label("[ 🔒 REQUIRE PASSWORD TO UNLOCK: ENABLED ]")
            self.btn_lock_toggle.get_style_context().add_class("active")
        else:
            self.btn_lock_toggle.set_label("[ 🔓 REQUIRE PASSWORD TO UNLOCK: DISABLED (DIRECT WAKE) ]")
            self.btn_lock_toggle.get_style_context().remove_class("active")

    def on_save(self, btn=None):
        new_cfg = {
            "timeout_minutes": self.selected_timeout,
            "lock_on_wake": self.selected_lock,
            "scene_mode": self.selected_scene
        }
        save_config(new_cfg)
        self.lbl_status.set_text(f"CONFIG SAVED // TIMEOUT: {self.selected_timeout}m // LOCK: {'ENABLED' if self.selected_lock else 'DISABLED'} // DAEMON NOTIFIED")

        self.btn_save.set_label("[ SAVED! ]")
        GLib.timeout_add(1200, lambda: self.btn_save.set_label("[ 💾 APPLY & SAVE ]") or False)

    def on_key_press(self, widget, event):
        if event.keyval in [Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Q]:
            self.close_window()
            return True
        elif event.keyval in [Gdk.KEY_Return, Gdk.KEY_KP_Enter]:
            self.on_save()
            return True
        return False

    def close_window(self):
        Gtk.main_quit()

def main():
    win = ScreensaverConfigWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
