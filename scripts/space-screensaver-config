TIMEOUT_PRESETS = [
    (0, "OFF / NEVER"),
    (1, "1 MIN"),
    (2, "2 MIN"),
    (5, "5 MIN (DEF)"),
    (10, "10 MIN"),
    (15, "15 MIN"),
    (30, "30 MIN"),
    (60, "1 HOUR"),
]

SCENE_PRESETS = [
    ("all", "1. ALL SCENES (CYCLE)"),
    ("arch", "2. ARCH ORBIT"),
    ("nasa", "3. NASA MEATBALL"),
    ("lunar", "4. APOLLO LANDER"),
    ("soviet", "5. SOVIET INSIGNIA"),
    ("gagarin", "6. VOSTOK-1 GAGARIN"),
]

def get_current_theme():
    theme_file = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.isfile(theme_file):
        try:
            with open(theme_file, "r") as f:
                theme = f.read().strip()
                if theme in THEMES:
                    return theme
        except Exception:
            pass
    return "nasa"

def load_config():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "timeout_minutes": 5,
        "lock_on_wake": False,
        "scene_mode": "all"
    }

def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

    try:
        subprocess.run(["pkill", "-USR1", "-x", "space-idle-daemon"], check=False)
    except Exception:
        pass

class ScreensaverConfigWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Screensaver Configuration")
        self.set_default_size(540, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_wmclass("space-screensaver-config", "space-screensaver-config")
        self.set_decorated(False)
        self.set_resizable(False)

        self.cfg = load_config()
        self.theme_name = get_current_theme()
        self.theme = THEMES.get(self.theme_name, THEMES["nasa"])

        self.selected_timeout = self.cfg.get("timeout_minutes", 5)
        self.selected_lock = self.cfg.get("lock_on_wake", False)
        self.selected_scene = self.cfg.get("scene_mode", "all")

        self.timeout_buttons = {}
        self.scene_buttons = {}

        self.apply_theme_css()
        self.build_ui()
        self.connect("key-press-event", self.on_key_press)

    def apply_theme_css(self):
        t = self.theme
        css = f"""
        * {{
            font-family: 'JetBrainsMono Nerd Font', 'Space Mono', 'Monospace', monospace;
            text-shadow: none;
            box-shadow: none;
            background-color: transparent;
        }}
        window, #main-window, .background, window.background, dialog {{
            background-color: {t['bg_chassis']};
            background-image: none;
            color: {t['text_primary']};
            border: 2px solid {t['border_color']};
            border-radius: {t['radius']};
        }}
        box, grid, viewport, scrolledwindow {{
            background-color: transparent;
            background-image: none;
        }}
        label {{
            background-color: transparent;
            background-image: none;
        }}
        .header-panel {{
            background-color: {t['bg_panel']};
            border-bottom: 2px solid {t['border_color']};
            padding: 12px 18px;
        }}
        .header-title {{
            font-size: 13px;
            font-weight: 900;
            color: {t['accent']};
            letter-spacing: 1.5px;
        }}
        .header-sub {{
            font-size: 9.5px;
            font-weight: 700;
            color: {t['text_secondary']};
        }}
        .content-box {{
            padding: 14px 18px;
            background-color: {t['bg_chassis']};
        }}
        .section-card {{
            background-color: {t['bg_card']};
            border: 1px solid {t['border_dim']};
            border-radius: {t['radius']};
            padding: 10px 12px;
            margin-bottom: 10px;
        }}
        .section-title {{
            font-size: 10px;
            font-weight: 800;
            color: {t['accent']};
            margin-bottom: 3px;
            letter-spacing: 0.5px;
        }}
        .section-desc {{
            font-size: 8.5px;
            color: {t['text_dim']};
            margin-bottom: 6px;
        }}
        button.chip-btn {{
            background-color: {t['bg_input']};
            background-image: none;
            border: 1px solid {t['border_dim']};
