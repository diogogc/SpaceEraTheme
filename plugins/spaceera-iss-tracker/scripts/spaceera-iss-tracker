#!/usr/bin/env bash
set -euo pipefail

uid=$(id -u 2>/dev/null || printf '%s' 1000)

ensure_secure_dir() {
  local dir="$1"
  if [[ -L "$dir" ]]; then
    rm -f "$dir" 2>/dev/null || return 1
  fi
  if ! mkdir -p -m 0700 "$dir" 2>/dev/null; then
    return 1
  fi
  if [[ -L "$dir" ]]; then
    return 1
  fi
  local owner
  owner=$(stat -c '%u' "$dir" 2>/dev/null || true)
  if [[ "$owner" != "$uid" ]]; then
    return 1
  fi
  chmod 0700 "$dir" 2>/dev/null || true
  return 0
}

state_base="${XDG_RUNTIME_DIR:-/tmp/user-$uid}"
state_dir="$state_base/omarchy-spaceera-iss-tracker"

if ! ensure_secure_dir "$state_dir"; then
  state_dir="/tmp/user-$uid/omarchy-spaceera-iss-tracker"
  if ! ensure_secure_dir "$state_dir"; then
    printf '%s\n' '{"ok":false,"error":"insecure state directory"}'
    exit 1
  fi
fi

cache_file="$state_dir/position.json"
pass_cache_file="$state_dir/next-pass.json"
config_base="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="$config_base/spaceera"
config_file="$config_dir/iss-location.json"
tle_file="$config_dir/iss-tle.json"
launches_file="$config_dir/upcoming-launches.json"

api_url="https://api.wheretheiss.at/v1/satellites/25544"
celestrak_url="https://celestrak.org/NORAD/elements/gp.php?CATNR=25544&FORMAT=JSON"

max_response_bytes=65536
max_stdout_bytes=131072
max_future_points=721
max_orbit_points=19

empty_location='{"configured":false,"city":"","latitude":0,"longitude":0}'
empty_pass='{"available":false,"current":false,"start":0,"end":0,"closest":0,"countdown":0,"duration":0,"min_distance_km":0,"radius_km":0,"horizon_hours":24}'

fetch_json() {
  local url="$1"
  local timeout="${2:-6}"
  curl -fsSL --max-time "$timeout" --max-filesize "$max_response_bytes" "$url" 2>/dev/null || true
}

emit_json() {
  local payload="$1"
  if ((${#payload} > max_stdout_bytes)); then
    printf '%s\n' '{"ok":false,"error":"output too large"}'
    return 1
  fi
  printf '%s\n' "$payload"
}

read_safe_file() {
  local path="$1"
  local max_bytes="${2:-$max_stdout_bytes}"
  python3 -c '
import sys, os, stat
path = sys.argv[1]
max_b = int(sys.argv[2])
expected_uid = int(sys.argv[3])
try:
    flags = os.O_RDONLY | os.O_NOFOLLOW
    if hasattr(os, "O_NONBLOCK"):
        flags |= os.O_NONBLOCK
    fd = os.open(path, flags)
except OSError:
    sys.exit(1)
try:
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != expected_uid:
        sys.exit(1)
    if st.st_size <= 0 or st.st_size > max_b:
        sys.exit(1)
    data = b""
    while len(data) < max_b:
        chunk = os.read(fd, min(65536, max_b - len(data)))
        if not chunk:
            break
        data += chunk
    sys.stdout.buffer.write(data)
except Exception:
    sys.exit(1)
finally:
    os.close(fd)
' "$path" "$max_bytes" "$uid" 2>/dev/null
}

atomic_write() {
  local target="$1"
  local content="$2"
  local target_dir
  target_dir="$(dirname "$target")"
  ensure_secure_dir "$target_dir" || return 1
  local tmp_file
  tmp_file="$(mktemp -p "$target_dir" ".tmp.XXXXXXXXXX" 2>/dev/null)" || return 1
  if ! printf '%s\n' "$content" > "$tmp_file" 2>/dev/null; then
    rm -f "$tmp_file" 2>/dev/null || true
    return 1
  fi
  chmod 0600 "$tmp_file" 2>/dev/null || true
  mv -f "$tmp_file" "$target" 2>/dev/null || { rm -f "$tmp_file" 2>/dev/null || true; return 1; }
}

read_location() {
  local content
  if content=$(read_safe_file "$config_file" 65536); then
    python3 -c '
import sys, json
try:
    d = json.loads(sys.stdin.read())
    out = {
        "configured": d.get("configured") is True,
        "city": str(d.get("city") or ""),
        "latitude": float(d.get("latitude") or 0),
        "longitude": float(d.get("longitude") or 0)
    }
    print(json.dumps(out, separators=(",", ":")))
except Exception:
    print(sys.argv[1])
' "$empty_location" <<<"$content" 2>/dev/null || printf '%s\n' "$empty_location"
  else
    printf '%s\n' "$empty_location"
  fi
}

fetch_and_save_tle() {
  ensure_secure_dir "$config_dir" || return 1
  local raw
  raw=$(fetch_json "$celestrak_url" 8)
  if [[ -n "$raw" ]]; then
    local wrapped
    wrapped=$(python3 -c '
import sys, json, time
try:
    raw = json.loads(sys.stdin.read())
    item = raw[0] if isinstance(raw, list) and len(raw) > 0 else raw
    if "EPOCH" in item or item.get("NORAD_CAT_ID") == 25544:
        wrapped = {
            "fetched_at": int(time.time()),
            "data": item
        }
        print(json.dumps(wrapped, separators=(",", ":")))
        sys.exit(0)
except Exception:
    pass
sys.exit(1)
' <<<"$raw" 2>/dev/null) || return 1
    atomic_write "$tle_file" "$wrapped" || return 1
    return 0
  fi
  return 1
}

if [[ "${1:-}" == "--fetch-tle" || "${1:-}" == "--update-tle" ]]; then
  if fetch_and_save_tle; then
    printf '%s\n' '{"ok":true,"message":"TLE updated successfully"}'
  else
    printf '%s\n' '{"ok":false,"error":"Failed to fetch TLE from CelesTrak"}'
    exit 1
  fi
  exit 0
fi

# Ensure TLE exists
if [[ ! -f "$tle_file" || -L "$tle_file" ]]; then
  fetch_and_save_tle || true
fi

fetch_and_save_launches() {
  ensure_secure_dir "$config_dir" || return 1
  local raw=""
  raw=$(python3 -c '
import urllib.request, json, time, sys
from datetime import datetime, timezone, timedelta

try:
    now = datetime.now(timezone.utc)
    week_later = now + timedelta(days=7)
    start_str = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    end_str = week_later.strftime("%Y-%m-%dT%H:%M:%SZ")

    url = f"https://ll.thespacedevs.com/2.2.0/launch/?net__gte={start_str}&net__lte={end_str}&limit=25"
    req = urllib.request.Request(url, headers={"User-Agent": "SpaceEraTheme-ISSTracker/1.0"})

    with urllib.request.urlopen(req, timeout=10) as resp:
        raw = json.loads(resp.read().decode("utf-8"))

    launches = []
    for item in raw.get("results", []):
        net_str = item.get("net") or ""
        net_ts = 0
        if net_str:
            try:
                dt = datetime.fromisoformat(net_str.replace("Z", "+00:00"))
                net_ts = int(dt.timestamp())
            except Exception:
                pass
        
        status_obj = item.get("status") or {}
        lsp = item.get("launch_service_provider") or {}
        pad = item.get("pad") or {}
        loc = pad.get("location") or {}
        rocket = item.get("rocket", {}).get("configuration") or {}
        mission = item.get("mission") or {}
        
        launches.append({
            "id": item.get("id", ""),
            "name": item.get("name", "Unknown Launch"),
            "net": net_str,
            "net_ts": net_ts,
            "status": status_obj.get("name", "Unknown"),
            "status_abbrev": status_obj.get("abbrev", ""),
            "provider": lsp.get("name", "Unknown Provider"),
            "rocket": rocket.get("full_name") or rocket.get("name") or "Unknown Rocket",
            "pad": pad.get("name", "Unknown Pad"),
            "location": loc.get("name", "Unknown Location"),
            "mission_type": mission.get("type", "") if mission else "",
            "mission_desc": mission.get("description", "") if mission else "",
            "orbit": (mission.get("orbit") or {}).get("name", "") if mission else "",
            "webcast": item.get("webcast_live", False)
        })

    output = {
        "ok": True,
        "fetched_at": int(time.time()),
        "count": len(launches),
        "launches": launches
    }
    print(json.dumps(output, separators=(",", ":")))
    sys.exit(0)
except Exception:
    sys.exit(1)
' 2>/dev/null || true)

  if [[ -n "$raw" ]]; then
    atomic_write "$launches_file" "$raw" || return 1
    return 0
  fi
  return 1
}

read_launches() {
  local cached=""
  if [[ -f "$launches_file" && ! -L "$launches_file" ]]; then
    cached=$(read_safe_file "$launches_file" || true)
  fi
  
  local needs_fetch=1
  if [[ -n "$cached" ]]; then
    local age
    age=$(python3 -c '
import sys, json, time
try:
    d = json.loads(sys.stdin.read())
    fat = int(d.get("fetched_at", 0))
    print(int(time.time()) - fat)
except Exception:
    print(999999)
' <<<"$cached" 2>/dev/null || echo "999999")
    if (( age < 86400 )); then
      needs_fetch=0
    fi
  fi

  if (( needs_fetch == 1 )); then
    if fetch_and_save_launches; then
      cached=$(read_safe_file "$launches_file" || true)
    fi
  fi

  if [[ -n "$cached" ]]; then
    printf '%s' "$cached"
  else
    printf '%s' '{"ok":false,"fetched_at":0,"count":0,"launches":[]}'
  fi
}

if [[ "${1:-}" == "--fetch-launches" || "${1:-}" == "--update-launches" ]]; then
  if fetch_and_save_launches; then
    launches_data=$(read_safe_file "$launches_file" || printf '%s' '{"ok":true,"fetched_at":0,"count":0,"launches":[]}')
    emit_json "$launches_data"
  else
    launches_data=$(read_safe_file "$launches_file" || printf '%s' '{"ok":false,"fetched_at":0,"count":0,"launches":[]}')
    emit_json "$launches_data"
  fi
  exit 0
fi

if [[ "${1:-}" == "--launches" ]]; then
  launches_data="$(read_launches)"
  emit_json "$launches_data"
  exit 0
fi

with_location() {
  local input="$1"
  local loc
  local next_pass="${2:-$empty_pass}"
  local launches
  launches="$(read_launches)"
  local payload
  loc="$(read_location)"
  payload="$(python3 -c '
import sys, json
try:
    base = json.loads(sys.argv[1])
    user_loc = json.loads(sys.argv[2])
    pass_data = json.loads(sys.argv[3])
    launches_data = json.loads(sys.argv[4])
    if "orbit" in base and isinstance(base["orbit"], list):
        base["orbit"] = base["orbit"][:19]
    base["user_location"] = user_loc
    base["next_pass"] = pass_data
    base["launches_info"] = launches_data
    print(json.dumps(base, separators=(",", ":")))
except Exception:
    sys.exit(1)
' "$input" "$loc" "$next_pass" "$launches" 2>/dev/null || printf '%s' "$input")"
  emit_json "$payload"
}

if [[ "${1:-}" == "--clear-city" ]]; then
  ensure_secure_dir "$config_dir" || true
  atomic_write "$config_file" "$empty_location" || true
  atomic_write "$pass_cache_file" "$empty_pass" || true
  with_location '{"ok":false,"cached":false,"latitude":0,"longitude":0,"altitude":0,"velocity":0,"visibility":"offline","timestamp":0,"orbit":[],"tle_info":{"available":false,"age_days":0,"stale":false,"warning":""}}'
  exit 0
fi

if [[ "${1:-}" == "--set-city" ]]; then
  city="${2:-}"
  if [[ -z "${city// }" ]]; then
    echo '{"ok":false,"error":"empty city"}'
    exit 1
  fi

  encoded="$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))' "$city")"
  geo_raw=""
  if command -v curl >/dev/null 2>&1; then
    geo_raw=$(fetch_json "https://geocoding-api.open-meteo.com/v1/search?name=$encoded&count=1&language=en&format=json" 6)
  fi

  city_data="$(python3 -c '
import sys, json
try:
    d = json.loads(sys.stdin.read())
    res = d["results"][0]
    name = res.get("name", "")
    cc = res.get("country_code", "")
    city_name = f"{name}, {cc}" if cc else name
    out = {
        "configured": True,
        "city": city_name,
        "latitude": float(res.get("latitude", 0)),
        "longitude": float(res.get("longitude", 0))
    }
    print(json.dumps(out, separators=(",", ":")))
except Exception:
    sys.exit(1)
' <<<"$geo_raw" 2>/dev/null)" || {
    echo '{"ok":false,"error":"city not found"}'
    exit 1
  }

  ensure_secure_dir "$config_dir" || true
  atomic_write "$config_file" "$city_data" || true
fi

# Run calculation engine using Python
loc_data="$(read_location)"
calc_result=""
if command -v python3 >/dev/null 2>&1; then
  calc_result=$(python3 - "$tle_file" "$loc_data" "$pass_cache_file" <<'PY'
import json
import math
import sys
import os
import time
from datetime import datetime, timezone

now = int(time.time())
tle_path = sys.argv[1]
loc = json.loads(sys.argv[2])
pass_cache_path = sys.argv[3]

earth_radius_km = 6378.137
mu = 398600.4418
J2 = 0.00108263

tle_info = {
    "available": False,
    "fetched_at": 0,
    "age_days": 0,
    "stale": False,
    "warning": ""
}

tle_data = None
try:
    flags = os.O_RDONLY | os.O_NOFOLLOW
    if hasattr(os, "O_NONBLOCK"):
        flags |= os.O_NONBLOCK
    fd = os.open(tle_path, flags)
    try:
        import stat
        st = os.fstat(fd)
        if stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid() and 0 < st.st_size <= 131072:
            data = b""
            while len(data) < 131072:
                chunk = os.read(fd, min(65536, 131072 - len(data)))
                if not chunk:
                    break
                data += chunk
            wrapped = json.loads(data.decode("utf-8"))
            fetched_at = int(wrapped.get("fetched_at", 0))
            tle_data = wrapped.get("data", {})
            age_days = (now - fetched_at) / 86400.0 if fetched_at > 0 else 0
            is_stale = age_days > 15.0
            warning_msg = f"TLE data is {int(age_days)} days old (>15d). Update recommended." if is_stale else ""
            tle_info = {
                "available": True,
                "fetched_at": fetched_at,
                "age_days": round(age_days, 1),
                "stale": is_stale,
                "warning": warning_msg
            }
    finally:
        os.close(fd)
except Exception:
    tle_data = None

def parse_epoch(epoch_str):
    try:
        dt = datetime.fromisoformat(epoch_str.rstrip("Z")).replace(tzinfo=timezone.utc)
        return dt.timestamp()
    except Exception:
        return now

def propagate_tle(tle, target_time):
    epoch_ts = parse_epoch(tle.get("EPOCH", ""))
    dt_sec = target_time - epoch_ts

    inc = math.radians(float(tle.get("INCLINATION", 51.6333)))
    raan = math.radians(float(tle.get("RA_OF_ASC_NODE", 0)))
    ecc = float(tle.get("ECCENTRICITY", 0.00077))
    argp = math.radians(float(tle.get("ARG_OF_PERICENTER", 0)))
    M0 = math.radians(float(tle.get("MEAN_ANOMALY", 0)))
    n_rev_day = float(tle.get("MEAN_MOTION", 15.4959))

    n_rad_s = n_rev_day * 2.0 * math.pi / 86400.0
    a = (mu / (n_rad_s ** 2)) ** (1.0 / 3.0)

    p = a * (1 - ecc**2)
    dRAAN_dt = -1.5 * J2 * (earth_radius_km / p)**2 * n_rad_s * math.cos(inc)
    dargp_dt = 0.75 * J2 * (earth_radius_km / p)**2 * n_rad_s * (5 * (math.cos(inc)**2) - 1)

    raan_t = raan + dRAAN_dt * dt_sec
    argp_t = argp + dargp_dt * dt_sec
    M_t = (M0 + n_rad_s * dt_sec) % (2 * math.pi)

    E = M_t
    for _ in range(10):
        E = E - (E - ecc * math.sin(E) - M_t) / (1 - ecc * math.cos(E))

    v = 2 * math.atan2(math.sqrt(1 + ecc) * math.sin(E / 2), math.sqrt(1 - ecc) * math.cos(E / 2))
    r = a * (1 - ecc * math.cos(E))
    u = argp_t + v

    j2000_epoch = 946728000.0
    d_j2000_days = (target_time - j2000_epoch) / 86400.0
    gmst = math.radians((280.46061837 + 360.98564736629 * d_j2000_days) % 360)

    long_node = raan_t - gmst
    x_orb = r * math.cos(u)
    y_orb = r * math.sin(u)

    X = x_orb * math.cos(long_node) - y_orb * math.cos(inc) * math.sin(long_node)
    Y = x_orb * math.sin(long_node) + y_orb * math.cos(inc) * math.cos(long_node)
    Z = y_orb * math.sin(inc)

    lat = math.degrees(math.atan2(Z, math.sqrt(X**2 + Y**2)))
    lon = math.degrees(math.atan2(Y, X))
    alt = r - earth_radius_km
    velocity = math.sqrt(mu / a) * 3600.0

    return {
        "latitude": round(lat, 5),
        "longitude": round(lon, 5),
        "altitude": round(alt, 1),
        "velocity": round(velocity, 1),
        "timestamp": int(target_time),
        "X": X, "Y": Y, "Z": Z, "r": r
    }

def get_sun_data(target_time):
    jd = target_time / 86400.0 + 2440587.5
    T = (jd - 2451545.0) / 36525.0
    l0 = (280.46646 + 36000.76983 * T) % 360.0
    m = (357.52911 + 35999.05029 * T) % 360.0
    m_rad = math.radians(m)
    c = (1.914602 - 0.004817 * T) * math.sin(m_rad) + (0.019993 - 0.000101 * T) * math.sin(2 * m_rad) + 0.000289 * math.sin(3 * m_rad)
    sun_lon = math.radians((l0 + c) % 360.0)
    eps = math.radians(23.439291 - 0.0130042 * T)
    
    d_j2000 = (target_time - 946728000.0) / 86400.0
    gmst = math.radians((280.46061837 + 360.98564736629 * d_j2000) % 360)
    
    dec = math.asin(math.sin(eps) * math.sin(sun_lon))
    ra = math.atan2(math.cos(eps) * math.sin(sun_lon), math.cos(sun_lon))
    sun_lon_ecef = ra - gmst
    
    sx = math.cos(dec) * math.cos(sun_lon_ecef)
    sy = math.cos(dec) * math.sin(sun_lon_ecef)
    sz = math.sin(dec)
    
    sub_lon = math.degrees(sun_lon_ecef % (2 * math.pi))
    if sub_lon > 180: sub_lon -= 360
    sub_lat = math.degrees(dec)
    
    return {"sub_lat": sub_lat, "sub_lon": sub_lon, "s_vec": (sx, sy, sz)}

def check_pass_visibility(user_lat_deg, user_lon_deg, sat_pos):
    t = sat_pos["timestamp"]
    sun = get_sun_data(t)
    
    u_lat = math.radians(user_lat_deg)
    u_lon = math.radians(user_lon_deg)
    s_lat = math.radians(sun["sub_lat"])
    s_lon = math.radians(sun["sub_lon"])
    
    cos_zenith = math.sin(u_lat) * math.sin(s_lat) + math.cos(u_lat) * math.cos(s_lat) * math.cos(u_lon - s_lon)
    sun_elev = 90.0 - math.degrees(math.acos(max(-1.0, min(1.0, cos_zenith))))
    
    sx, sy, sz = sun["s_vec"]
    X, Y, Z = sat_pos["X"], sat_pos["Y"], sat_pos["Z"]
    r = sat_pos["r"]
    proj = X * sx + Y * sy + Z * sz
    sat_sunlit = (proj > 0) or ((r * r - proj * proj) > (earth_radius_km * earth_radius_km))
    
    local_solar_hour = ((t + user_lon_deg * 240.0) % 86400.0) / 3600.0
    
    is_flare = False
    flare_type = "NONE"
    flare_label = "Radio Tracking Only"
    
    if not sat_sunlit:
        flare_type = "ECLIPSED"
        flare_label = "Earth Shadow (In Eclipse)"
    elif sun_elev > -4.0:
        flare_type = "DAYLIGHT"
        flare_label = "Daylight Pass (Sun in Sky)"
    else:
        is_flare = True
        if 16.0 <= local_solar_hour <= 22.0 or (sun_elev < 0 and 12.0 < local_solar_hour <= 24.0):
            flare_type = "DUSK_FLARE"
            flare_label = "⭐ Sunset Visual Flare (Naked Eye)"
        elif 3.0 <= local_solar_hour <= 7.0 or (sun_elev < 0 and 0.0 <= local_solar_hour <= 12.0):
            flare_type = "DAWN_FLARE"
            flare_label = "⭐ Dawn Visual Flare (Naked Eye)"
        else:
            flare_type = "NIGHT_FLARE"
            flare_label = "⭐ Night Visual Flare (Naked Eye)"
            
    return {
        "is_flare": is_flare,
        "type": flare_type,
        "label": flare_label,
        "sun_elev_deg": round(sun_elev, 1),
        "sat_sunlit": sat_sunlit
    }

if tle_data:
    current_pos = propagate_tle(tle_data, now)
    orbit_points = [propagate_tle(tle_data, now + offset) for offset in range(-2700, 2701, 300)]
    
    # Calculate current ISS illumination state
    cur_sun = get_sun_data(now)
    cur_sx, cur_sy, cur_sz = cur_sun["s_vec"]
    cur_proj = current_pos["X"] * cur_sx + current_pos["Y"] * cur_sy + current_pos["Z"] * cur_sz
    cur_sunlit = (cur_proj > 0) or ((current_pos["r"]**2 - cur_proj**2) > (earth_radius_km**2))
    current_illum = "daylight" if cur_sunlit else "eclipsed"

    # Clean orbit points representation
    clean_orbit = [
        {"latitude": p["latitude"], "longitude": p["longitude"], "altitude": p["altitude"], "velocity": p["velocity"], "timestamp": p["timestamp"]}
        for p in orbit_points
    ]
    
    # Predict next pass using TLE propagation
    pass_info = {
        "available": False, "current": False, "start": 0, "end": 0, "closest": 0,
        "countdown": 0, "duration": 0, "min_distance_km": 0, "radius_km": 0, "horizon_hours": 24,
        "flare": {
            "is_flare": False,
            "type": "NONE",
            "label": "Standby",
            "sun_elev_deg": 0.0,
            "sat_sunlit": False
        }
    }
    
    if loc.get("configured") is True:
        u_lat_deg = float(loc.get("latitude", 0))
        u_lon_deg = float(loc.get("longitude", 0))
        user_lat = math.radians(u_lat_deg)
        user_lon = math.radians(u_lon_deg)
        alt = current_pos["altitude"]
        visibility_radius = earth_radius_km * math.acos(earth_radius_km / (earth_radius_km + max(alt, 1.0)))

        def distance_km(p):
            plat = math.radians(float(p["latitude"]))
            plon = math.radians(float(p["longitude"]))
            dlat = plat - user_lat
            dlon = plon - user_lon
            a = math.sin(dlat / 2)**2 + math.cos(user_lat) * math.cos(plat) * math.sin(dlon / 2)**2
            return earth_radius_km * 2 * math.atan2(math.sqrt(a), math.sqrt(max(0.0, 1 - a)))

        # Sample future 24h at 120s steps
        samples = []
        for step in range(0, 86401, 120):
            t_sample = now + step
            p_sample = propagate_tle(tle_data, t_sample)
            dist = distance_km(p_sample)
            samples.append((t_sample, dist, dist <= visibility_radius))

        in_pass = False
        start_t = None
        best_t = None
        best_d = None
        last_t = None

        for t_sample, dist, inside in samples:
            if inside and not in_pass:
                in_pass = True
                start_t = t_sample
                best_t = t_sample
                best_d = dist
                last_t = t_sample
            elif inside:
                last_t = t_sample
                if best_d is None or dist < best_d:
                    best_d = dist
                    best_t = t_sample
            elif in_pass:
                break

        if in_pass and start_t is not None:
            end_t = last_t or start_t
            peak_t = best_t or start_t
            peak_pos = propagate_tle(tle_data, peak_t)
            flare_info = check_pass_visibility(u_lat_deg, u_lon_deg, peak_pos)

            pass_info.update({
                "available": True,
                "current": start_t <= now + 120,
                "start": start_t,
                "end": end_t,
                "closest": peak_t,
                "countdown": max(0, start_t - now),
                "duration": max(0, end_t - start_t),
                "min_distance_km": round(best_d or 0),
                "radius_km": round(visibility_radius),
                "horizon_hours": 24,
                "flare": flare_info
            })

    output = {
        "ok": True,
        "cached": False,
        "latitude": current_pos["latitude"],
        "longitude": current_pos["longitude"],
        "altitude": current_pos["altitude"],
        "velocity": current_pos["velocity"],
        "visibility": current_illum,
        "timestamp": current_pos["timestamp"],
        "orbit": clean_orbit,
        "next_pass": pass_info,
        "tle_info": tle_info
    }
    print(json.dumps(output, separators=(",", ":")))
else:
    print("")
PY
  )
fi

if [[ -n "$calc_result" ]]; then
  is_ok=$(python3 -c 'import sys, json; d=json.loads(sys.stdin.read()); sys.exit(0 if d.get("ok") is True else 1)' <<<"$calc_result" 2>/dev/null && echo "yes" || echo "no")
  if [[ "$is_ok" == "yes" ]]; then
    atomic_write "$cache_file" "$calc_result" || true
    next_pass_data="$(python3 -c 'import sys, json; d=json.loads(sys.stdin.read()); print(json.dumps(d.get("next_pass", {}), separators=(",", ":")))' <<<"$calc_result" 2>/dev/null || printf '%s' "$empty_pass")"
    atomic_write "$pass_cache_file" "$next_pass_data" || true
    with_location "$calc_result" "$next_pass_data"
    exit 0
  fi
fi

# Fallback to REST API if TLE calculation is unavailable
raw=""
if command -v curl >/dev/null 2>&1; then
  raw=$(fetch_json "$api_url" 4)
fi

if [[ -n "$raw" ]]; then
  payload=$(python3 -c '
import sys, json
try:
    d = json.loads(sys.stdin.read())
    if "latitude" in d and "longitude" in d and "timestamp" in d:
        out = {
            "ok": True,
            "cached": False,
            "latitude": float(d["latitude"]),
            "longitude": float(d["longitude"]),
            "altitude": float(d.get("altitude") or 0),
            "velocity": float(d.get("velocity") or 0),
            "visibility": str(d.get("visibility") or "unknown"),
            "timestamp": int(d["timestamp"]),
            "orbit": [],
            "tle_info": {"available": False, "age_days": 0, "stale": False, "warning": ""}
        }
        print(json.dumps(out, separators=(",", ":")))
        sys.exit(0)
except Exception:
    pass
sys.exit(1)
' <<<"$raw" 2>/dev/null) || payload=""

  if [[ -n "$payload" ]]; then
    atomic_write "$cache_file" "$payload" || true
    with_location "$payload" "$empty_pass"
    exit 0
  fi
fi

cache_content=""
if cache_content=$(read_safe_file "$cache_file"); then
  cached_payload="$(python3 -c '
import sys, json
try:
    d = json.loads(sys.stdin.read())
    d["cached"] = True
    print(json.dumps(d, separators=(",", ":")))
except Exception:
    sys.exit(1)
' <<<"$cache_content" 2>/dev/null || printf '%s' "$cache_content")"
  with_location "$cached_payload" "$empty_pass"
  exit 0
fi

with_location '{"ok":false,"cached":false,"latitude":0,"longitude":0,"altitude":0,"velocity":0,"visibility":"offline","timestamp":0,"orbit":[],"tle_info":{"available":false,"age_days":0,"stale":false,"warning":""}}'
