#!/usr/bin/env bash
set -euo pipefail

state_base="${XDG_RUNTIME_DIR:-/tmp}"
state_dir="$state_base/omarchy-spaceera-telemetry"
if ! mkdir -p "$state_dir" 2>/dev/null || ! touch "$state_dir/.write-test" 2>/dev/null; then
  state_dir="/tmp/omarchy-spaceera-telemetry"
  mkdir -p "$state_dir"
else
  rm -f "$state_dir/.write-test"
fi
state_file="$state_dir/cpu.stat"

read_temp_file() {
  local file="$1"
  local value

  value=$(sed -n '1p' "$file" 2>/dev/null) || return 1
  [[ "$value" =~ ^[0-9]+$ ]] || return 1
  (( value >= 10000 && value <= 120000 )) || return 1

  printf '%s\n' "$value"
}

read_system_temp() {
  local hwmon name input label_file label value max_temp=0

  for hwmon in /sys/class/hwmon/hwmon*; do
    [[ -d "$hwmon" ]] || continue
    name=$(sed -n '1p' "$hwmon/name" 2>/dev/null || true)
    [[ "$name" == "coretemp" ]] || continue

    for input in "$hwmon"/temp*_input; do
      label_file="${input%_input}_label"
      label=$(sed -n '1p' "$label_file" 2>/dev/null || true)
      [[ "$label" == "Package id 0" ]] || continue
      read_temp_file "$input" && return 0
    done
  done

  for hwmon in /sys/class/hwmon/hwmon*; do
    [[ -d "$hwmon" ]] || continue
    for input in "$hwmon"/temp*_input; do
      label_file="${input%_input}_label"
      label=$(sed -n '1p' "$label_file" 2>/dev/null || true)
      [[ "$label" == "CPU" ]] || continue
      read_temp_file "$input" && return 0
    done
  done

  for input in /sys/class/hwmon/hwmon*/temp*_input; do
    value=$(read_temp_file "$input" 2>/dev/null || true)
    [[ -n "$value" ]] || continue
    (( value > max_temp )) && max_temp="$value"
  done

  (( max_temp > 0 )) && printf '%s\n' "$max_temp"
}

read_vram_percent() {
  local used total out card sysfile totalfile

  if command -v nvidia-smi &>/dev/null; then
    out=$(nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null || true)
    if [[ -n "$out" ]]; then
      out=$(head -n 1 <<< "$out")
      if [[ "$out" =~ ([0-9]+),[[:space:]]*([0-9]+) ]]; then
        used="${BASH_REMATCH[1]}"
        total="${BASH_REMATCH[2]}"
        if (( total > 0 )); then
          printf '%d\n' "$(( (used * 100 + total / 2) / total ))"
          return 0
        fi
      fi
    fi
  fi

  for card in /sys/class/drm/card[0-9]*/device; do
    [[ -d "$card" ]] || continue

    if [[ -r "$card/mem_info_vram_used" && -r "$card/mem_info_vram_total" ]]; then
      used=$(sed -n '1p' "$card/mem_info_vram_used" 2>/dev/null || true)
      total=$(sed -n '1p' "$card/mem_info_vram_total" 2>/dev/null || true)
      if [[ "$used" =~ ^[0-9]+$ && "$total" =~ ^[0-9]+$ ]] && (( total > 0 )); then
        printf '%d\n' "$(( (used * 100 + total / 2) / total ))"
        return 0
      fi
    fi

    for sysfile in "$card"/tile*/memory/vram*/used "$card"/gt*/mem_info_vram_used; do
      [[ -r "$sysfile" ]] || continue
      totalfile="${sysfile%_used}_total"
      [[ -r "$totalfile" ]] || continue
      used=$(sed -n '1p' "$sysfile" 2>/dev/null || true)
      total=$(sed -n '1p' "$totalfile" 2>/dev/null || true)
      if [[ "$used" =~ ^[0-9]+$ && "$total" =~ ^[0-9]+$ ]] && (( total > 0 )); then
        printf '%d\n' "$(( (used * 100 + total / 2) / total ))"
        return 0
      fi
    done
  done

  return 1
}

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
idle_now=$((idle + iowait))
total_now=$((user + nice + system + idle + iowait + irq + softirq + steal))

cpu_percent=0
if [[ -r "$state_file" ]]; then
  read -r total_prev idle_prev < "$state_file" || true
  total_delta=$((total_now - ${total_prev:-0}))
  idle_delta=$((idle_now - ${idle_prev:-0}))
  if (( total_delta > 0 )); then
    cpu_percent=$(( (100 * (total_delta - idle_delta) + total_delta / 2) / total_delta ))
  fi
fi
printf '%s %s\n' "$total_now" "$idle_now" > "$state_file"

mem_percent=$(awk '
  /^MemTotal:/ { total = $2 }
  /^MemAvailable:/ { available = $2 }
  END {
    if (total > 0) printf "%d", ((total - available) * 100 / total) + 0.5;
    else printf "0";
  }
' /proc/meminfo)

vram_percent=$(read_vram_percent || true)
if [[ -n "$vram_percent" ]]; then
  vram_json="$vram_percent"
  vram_text=$(printf '%02d%%' "$vram_percent")
else
  vram_json="null"
  vram_text="n/a"
fi

load_avg=$(awk '{ print $1 }' /proc/loadavg)
disk_percent=$(df -P / | awk 'NR == 2 { gsub("%", "", $5); print $5 }')
temp_millic=$(read_system_temp || true)
if [[ -n "$temp_millic" ]]; then
  temp_c=$(( (temp_millic + 500) / 1000 ))
  temp_json="$temp_c"
  temp_text=$(printf '%02dC' "$temp_c")
else
  temp_json="null"
  temp_text="n/a"
fi

battery_text="Battery n/a"
for battery in /sys/class/power_supply/BAT*; do
  [[ -d "$battery" ]] || continue
  capacity=$(<"$battery/capacity")
  status=$(<"$battery/status")
  battery_text="Battery ${capacity}% ${status}"
  break
done

jq -cn \
  --argjson cpu "$cpu_percent" \
  --argjson mem "$mem_percent" \
  --argjson vram "$vram_json" \
  --argjson temp "$temp_json" \
  --arg load "$load_avg" \
  --argjson disk "$disk_percent" \
  --arg vramText "$vram_text" \
  --arg tempText "$temp_text" \
  --arg battery "$battery_text" \
  '{
    cpu: $cpu,
    mem: $mem,
    vram: $vram,
    temp: $temp,
    load: $load,
    disk: $disk,
    vramText: $vramText,
    tempText: $tempText,
    battery: $battery
  }'
